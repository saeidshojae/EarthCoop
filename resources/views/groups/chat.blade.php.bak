            'realtimeReactions' => (bool) config('group-chat.features.realtime_reactions', false),
            'realtimePosts' => (bool) config('group-chat.features.realtime_posts', true),
            'realtimePolls' => (bool) config('group-chat.features.realtime_polls', false),
        ],
    ];
@endphp
