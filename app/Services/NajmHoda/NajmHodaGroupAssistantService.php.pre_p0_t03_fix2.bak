<?php

namespace App\Services\NajmHoda;

use App\Events\MessageCreated;
use App\Models\Blog;
use App\Models\Category;
use App\Models\ChatRequest;
use App\Models\Comment;
use App\Models\Group;
use App\Models\GroupUser;
use App\Models\Message;
use App\Models\MessageReaction;
use App\Models\NajmHodaGroupActionLog;
use App\Models\NajmHodaGroupActionItem;
use App\Models\NajmHodaGroupConfig;
use App\Models\NajmHodaGroupMemory;
use App\Models\Poll;
use App\Models\PollOption;
use App\Models\Reaction;
use App\Models\User;
use Carbon\Carbon;
use Illuminate\Support\Facades\Hash;

class NajmHodaGroupAssistantService
{
    public function ensureBotUser(): User
    {
        $email = (string) config('najm-hoda.group_assistant.bot_email', 'najm-hoda-bot@local.invalid');

        $bot = User::where('email', $email)->first();
        if ($bot) {
            return $bot;
        }

        return User::create([
            'email' => $email,
            'password' => Hash::make(bin2hex(random_bytes(16))),
            'first_name' => (string) config('najm-hoda.group_assistant.bot_first_name', 'نجم'),
            'last_name' => (string) config('najm-hoda.group_assistant.bot_last_name', 'هدا'),
            'status' => 'active',
            'email_verified_at' => now(),
            'terms_accepted_at' => now(),
        ]);
    }

    public function ensureGroupAssistantSetup(Group $group): void
    {
        $bot = $this->ensureBotUser();

        NajmHodaGroupConfig::firstOrCreate(
            ['group_id' => $group->id],
            [
                'enabled' => (bool) config('najm-hoda.group_assistant.enabled', true),
                'assistant_role' => (string) config('najm-hoda.group_assistant.assistant_role', 'secretary'),
                'default_agent' => (string) config('najm-hoda.group_assistant.default_agent', 'steward'),
                'auto_reply_mode' => (string) config('najm-hoda.group_assistant.auto_reply_mode', 'mention_or_question'),
                'knowledge_scope' => (string) config('najm-hoda.group_assistant.knowledge_scope', 'hybrid'),
                'meeting_mode_enabled' => (bool) config('najm-hoda.group_assistant.meeting_mode_enabled', true),
                'allow_proactive_guidance' => (bool) config('najm-hoda.group_assistant.allow_proactive_guidance', true),
                'max_replies_per_hour' => (int) config('najm-hoda.group_assistant.max_replies_per_hour', 12),
                'min_reply_interval_seconds' => (int) config('najm-hoda.group_assistant.min_reply_interval_seconds', 90),
                'policy' => [
                    'allow_private_messages' => (bool) config('najm-hoda.group_assistant.allow_private_messages', true),
                    'private_message_mode' => (string) config('najm-hoda.group_assistant.private_message_mode', 'direct'),
                    'action_executor' => [
                        'enabled' => (bool) config('najm-hoda.group_assistant.action_executor.enabled', true),
                        'propose_before_execute' => (bool) config('najm-hoda.group_assistant.action_executor.propose_before_execute', false),
                        'allow_create_post' => (bool) config('najm-hoda.group_assistant.action_executor.allow_create_post', true),
                        'allow_create_poll' => (bool) config('najm-hoda.group_assistant.action_executor.allow_create_poll', true),
                        'allow_create_comment' => (bool) config('najm-hoda.group_assistant.action_executor.allow_create_comment', true),
                        'allow_react_message' => (bool) config('najm-hoda.group_assistant.action_executor.allow_react_message', true),
                        'allow_react_post' => (bool) config('najm-hoda.group_assistant.action_executor.allow_react_post', true),
                        'allow_react_comment' => (bool) config('najm-hoda.group_assistant.action_executor.allow_react_comment', true),
                        'max_actions_per_hour' => (int) config('najm-hoda.group_assistant.action_executor.max_actions_per_hour', 6),
                        'permitted_roles' => (array) config('najm-hoda.group_assistant.action_executor.permitted_roles', [2, 3]),
                    ],
                    'moderation' => [
                        'enabled' => false,
                        'auto_cleanup_enabled' => false,
                        'cleanup_interval_hours' => 24,
                        'scan_window_hours' => 24,
                        'max_messages_per_run' => 30,
                        'strictness' => 'balanced',
                        'next_cleanup_at' => null,
                        'last_cleanup_at' => null,
                    ],
                ],
            ]
        );

        GroupUser::updateOrCreate(
            ['group_id' => $group->id, 'user_id' => $bot->id],
            [
                'role' => (int) config('najm-hoda.group_assistant.default_group_role', 3),
                'status' => 1,
                'expired' => null,
            ]
        );
    }

    public function handleIncomingMessage(Message $trigger): void
    {
        if (!(bool) config('najm-hoda.group_assistant.enabled', true)) {
            return;
        }

        $group = $trigger->group;
        if (!$group) {
            return;
        }

        $this->ensureGroupAssistantSetup($group);
        $config = NajmHodaGroupConfig::where('group_id', $group->id)->first();
        if ($config) {
            $config = $this->applyGlobalGroupAssistantOverrides($config);
        }
        if (!$config || !$config->enabled) {
            return;
        }

        $bot = $this->ensureBotUser();
        if ((int) $trigger->user_id === (int) $bot->id) {
            return;
        }

        $decision = $this->shouldRespond($trigger, $config, $bot->id);
        if (!$decision['allowed']) {
            $this->logAction($group->id, $trigger->id, null, 'message_reply', 'skipped', null, $decision['reason'], [
                'mode' => $config->auto_reply_mode,
            ]);
            return;
        }

        $cleanText = trim(strip_tags((string) $trigger->message));
        if ($cleanText === '') {
            return;
        }

        $privateMessageResult = $this->tryHandlePrivateMessageCommand($group, $trigger, $config, $bot, $cleanText);
        if ($privateMessageResult !== null) {
            $response = Message::create([
                'group_id' => $group->id,
                'user_id' => $bot->id,
                'message' => nl2br(e((string) $privateMessageResult['group_reply'])),
                'parent_id' => (string) $trigger->id,
                'thread_id' => $trigger->thread_id ?: $trigger->id,
            ]);
            event(new MessageCreated($response, $group, $bot));
            $this->logAction(
                $group->id,
                $trigger->id,
                $response->id,
                'private_message',
                (string) ($privateMessageResult['decision'] ?? 'executed'),
                'steward',
                (string) ($privateMessageResult['reason'] ?? 'ok'),
                (array) ($privateMessageResult['context'] ?? [])
            );
            return;
        }

        $moderationResult = $this->tryHandleModerationCommand($group, $trigger, $config, $bot, $cleanText);
        if ($moderationResult !== null) {
            $response = Message::create([
                'group_id' => $group->id,
                'user_id' => $bot->id,
                'message' => nl2br(e((string) $moderationResult['group_reply'])),
                'parent_id' => (string) $trigger->id,
                'thread_id' => $trigger->thread_id ?: $trigger->id,
            ]);
            event(new MessageCreated($response, $group, $bot));
            $this->logAction(
                $group->id,
                $trigger->id,
                $response->id,
                'group_moderation',
                (string) ($moderationResult['decision'] ?? 'executed'),
                'steward',
                (string) ($moderationResult['reason'] ?? 'ok'),
                (array) ($moderationResult['context'] ?? [])
            );
            return;
        }

        $groupActionResult = $this->tryHandleGroupActionCommand($group, $trigger, $config, $bot, $cleanText);
        if ($groupActionResult !== null) {
            $response = Message::create([
                'group_id' => $group->id,
                'user_id' => $bot->id,
                'message' => nl2br(e((string) $groupActionResult['group_reply'])),
                'parent_id' => (string) $trigger->id,
                'thread_id' => $trigger->thread_id ?: $trigger->id,
            ]);
            event(new MessageCreated($response, $group, $bot));
            $this->logAction(
                $group->id,
                $trigger->id,
                $response->id,
                'group_action_execute',
                (string) ($groupActionResult['decision'] ?? 'executed'),
                'guide',
                (string) ($groupActionResult['reason'] ?? 'ok'),
                (array) ($groupActionResult['context'] ?? [])
            );
            return;
        }

        $snapshot = $this->getGroupKnowledgeSnapshot($group);
        $structuredReply = $this->tryStructuredMetricQuery($cleanText, $group, $snapshot);
        if ($structuredReply !== null) {
            $response = Message::create([
                'group_id' => $group->id,
                'user_id' => $bot->id,
                'message' => nl2br(e($structuredReply)),
                'parent_id' => (string) $trigger->id,
                'thread_id' => $trigger->thread_id ?: $trigger->id,
            ]);
            event(new MessageCreated($response, $group, $bot));
            $this->logAction($group->id, $trigger->id, $response->id, 'message_reply', 'executed', 'group_query', 'structured_metric_query', [
                'source' => 'group_database_snapshot',
            ]);
            return;
        }

        $factIntent = $this->detectGroupFactIntent($cleanText);
        if ($factIntent !== null) {
            $replyText = $this->buildGroupFactsReply($group, $factIntent);
            $response = Message::create([
                'group_id' => $group->id,
                'user_id' => $bot->id,
                'message' => nl2br(e($replyText)),
                'parent_id' => (string) $trigger->id,
                'thread_id' => $trigger->thread_id ?: $trigger->id,
            ]);
            event(new MessageCreated($response, $group, $bot));

            $this->logAction($group->id, $trigger->id, $response->id, 'message_reply', 'executed', 'group_facts', 'facts_answered', [
                'intent' => $factIntent,
                'source' => 'group_database_snapshot',
            ]);
            return;
        }

        $agent = $this->selectAgent($cleanText, $config->default_agent);
        $context = $this->buildContext($group, $trigger, $config, $bot->id, $agent);

        $orchestrator = app(NajmHodaOrchestrator::class);
        $result = $orchestrator->route($cleanText, $context);
        if (!($result['success'] ?? false)) {
            $this->logAction($group->id, $trigger->id, null, 'message_reply', 'failed', $agent, 'assistant_failed', [
                'error' => $result['error'] ?? null,
            ]);
            return;
        }

        $replyText = $this->sanitizeReply($result['message'] ?? '');
        if ($replyText === '') {
            return;
        }

        $messageData = [
            'group_id' => $group->id,
            'user_id' => $bot->id,
            'message' => $replyText,
            'parent_id' => (string) $trigger->id,
        ];

        if (!empty($trigger->thread_id)) {
            $messageData['thread_id'] = $trigger->thread_id;
        } else {
            $messageData['thread_id'] = $trigger->id;
            $trigger->incrementReplyCount();
        }

        $response = Message::create($messageData);
        event(new MessageCreated($response, $group, $bot));

        $this->logAction($group->id, $trigger->id, $response->id, 'message_reply', 'executed', $agent, 'ok', [
            'knowledge_scope' => $config->knowledge_scope,
        ]);

        $this->captureMeetingMemoryIfNeeded($group->id, $trigger, $response, $config);
        $this->extractAndStoreActionItemsIfNeeded($group, $trigger, $response, $config, $bot);
    }

    protected function applyGlobalGroupAssistantOverrides(NajmHodaGroupConfig $config): NajmHodaGroupConfig
    {
        $config->auto_reply_mode = (string) config('najm-hoda.group_assistant.auto_reply_mode', $config->auto_reply_mode);
        $config->knowledge_scope = (string) config('najm-hoda.group_assistant.knowledge_scope', $config->knowledge_scope);
        $config->default_agent = (string) config('najm-hoda.group_assistant.default_agent', $config->default_agent);
        $config->max_replies_per_hour = (int) config('najm-hoda.group_assistant.max_replies_per_hour', $config->max_replies_per_hour);
        $config->min_reply_interval_seconds = (int) config('najm-hoda.group_assistant.min_reply_interval_seconds', $config->min_reply_interval_seconds);
        $config->meeting_mode_enabled = (bool) config('najm-hoda.group_assistant.meeting_mode_enabled', $config->meeting_mode_enabled)
            && (bool) $config->meeting_mode_enabled;
        $config->allow_proactive_guidance = (bool) config('najm-hoda.group_assistant.allow_proactive_guidance', $config->allow_proactive_guidance)
            && (bool) $config->allow_proactive_guidance;

        if (!(bool) config('najm-hoda.group_assistant.enabled', true)) {
            $config->enabled = false;
        }

        return $config;
    }

    protected function shouldRespond(Message $trigger, NajmHodaGroupConfig $config, int $botUserId): array
    {
        $mode = $config->auto_reply_mode;
        $plain = mb_strtolower(trim(strip_tags((string) $trigger->message)));

        $hourlyCount = Message::where('group_id', $trigger->group_id)
            ->where('user_id', $botUserId)
            ->where('created_at', '>=', now()->subHour())
            ->count();

        if ($hourlyCount >= $config->max_replies_per_hour) {
            return ['allowed' => false, 'reason' => 'hourly_limit'];
        }

        $lastReply = Message::where('group_id', $trigger->group_id)
            ->where('user_id', $botUserId)
            ->latest('id')
            ->first();

        if ($lastReply && now()->diffInSeconds($lastReply->created_at) < $config->min_reply_interval_seconds) {
            return ['allowed' => false, 'reason' => 'cooldown'];
        }

        $isMentioned = $this->isBotMentioned($plain);
        $isQuestion = str_contains($plain, '?') || str_contains($plain, 'ØŸ');
        $isMeetingIntent = $this->containsMeetingKeywords($plain);

        if ($mode === 'disabled') {
            return ['allowed' => false, 'reason' => 'mode_disabled'];
        }
        if ($mode === 'mention_only' && !$isMentioned) {
            return ['allowed' => false, 'reason' => 'mention_required'];
        }
        if ($mode === 'mention_or_question' && !$isMentioned && !$isQuestion) {
            if ($config->meeting_mode_enabled && $isMeetingIntent) {
                return ['allowed' => true, 'reason' => 'meeting_intent'];
            }
            return ['allowed' => false, 'reason' => 'no_trigger'];
        }

        return ['allowed' => true, 'reason' => 'triggered'];
    }

    protected function isBotMentioned(string $plain): bool
    {
        foreach ((array) config('najm-hoda.group_assistant.trigger_keywords', []) as $keyword) {
            if ($keyword !== '' && mb_stripos($plain, mb_strtolower((string) $keyword)) !== false) {
                return true;
            }
        }

        return false;
    }

    protected function selectAgent(string $text, string $fallback): string
    {
        if ($this->containsMeetingKeywords(mb_strtolower($text))) {
            return 'guide';
        }

        $strategyKeywords = ['استراتژی', 'نقشه راه', 'هدف', 'چشم انداز', 'چشم‌انداز', 'برنامه'];
        foreach ($strategyKeywords as $keyword) {
            if (mb_stripos($text, $keyword) !== false) {
                return 'guide';
            }
        }

        return $fallback ?: 'steward';
    }

    protected function buildContext(
        Group $group,
        Message $trigger,
        NajmHodaGroupConfig $config,
        int $botUserId,
        string $agent
    ): array {
        $recentMessages = Message::where('group_id', $group->id)
            ->latest('id')
            ->take(20)
            ->get(['id', 'user_id', 'message', 'created_at'])
            ->reverse()
            ->map(function (Message $message) use ($botUserId) {
                return [
                    'id' => $message->id,
                    'speaker' => (int) $message->user_id === $botUserId ? 'najm_hoda' : 'user',
                    'text' => trim(strip_tags((string) $message->message)),
                    'at' => optional($message->created_at)->toIso8601String(),
                ];
            })
            ->values()
            ->all();

        return [
            'force_agent' => $agent,
            'user_is_admin' => false,
            'group_assistant_mode' => true,
            'group_id' => $group->id,
            'group_name' => $group->name,
            'group_type' => $group->group_type,
            'group_leadership' => $this->getGroupLeadershipContext($group),
            'group_data_snapshot' => $this->getGroupKnowledgeSnapshot($group),
            'knowledge_scope' => $config->knowledge_scope,
            'assistant_role' => $config->assistant_role,
            'trigger_message_id' => $trigger->id,
            'trigger_user_id' => $trigger->user_id,
            'recent_messages' => $recentMessages,
            'expected_output' => [
                'goal' => 'respond_in_group_chat',
                'tone' => 'professional_and_helpful',
                'privacy_mode' => $config->knowledge_scope,
                'factual_policy' => [
                    'use_group_data_snapshot_for_group_facts',
                    'do_not_claim_no_access_if_snapshot_has_data',
                    'if_data_missing_say_not_registered_not_no_access',
                ],
            ],
            'platform_capabilities' => $this->platformCapabilitiesSummary(),
            'platform_principles' => $this->platformPrinciples(),
            'cross_group_insights' => $this->getCrossGroupInsights($config),
        ];
    }

    protected function isLeadershipQuestion(string $text): bool
    {
        $plain = mb_strtolower(trim($text));
        $keywords = [
            'مدیر گروه',
            'مدیر این گروه',
            'چه کسی مدیر',
            'کی مدیر',
            'بازرس گروه',
            'بازرس این گروه',
            'چه کسی بازرس',
            'کی بازرس',
            'نقش های گروه',
            'نقش‌های گروه',
        ];

        foreach ($keywords as $keyword) {
            if (mb_stripos($plain, $keyword) !== false) {
                return true;
            }
        }

        return false;
    }

    protected function detectGroupFactIntent(string $text): ?string
    {
        $plain = mb_strtolower(trim($text));

        $intentMap = [
            'leadership' => [
                'مدیر گروه', 'مدیر این گروه', 'چه کسی مدیر', 'کی مدیر',
                'بازرس گروه', 'بازرس این گروه', 'چه کسی بازرس', 'کی بازرس',
                'نقش های گروه', 'نقش‌های گروه',
            ],
            'members' => [
                'اعضای فعال', 'تعداد اعضا', 'اعضا چند نفر', 'ناظرها', 'ناظر ها', 'مدیرها', 'بازرسان',
            ],
            'polls' => [
                'نظرسنجی', 'نظرسنجی ها', 'نظرسنجی‌های', 'poll',
            ],
            'elections' => [
                'انتخابات', 'انتخابات داخلی', 'انتخابات سیستمی', 'کاندید', 'رای گیری', 'رأی گیری',
            ],
            'candidates' => [
                'کاندیدا', 'کاندید', 'نامزد', 'رای کاندیدا', 'رأی کاندیدا', 'نتیجه انتخابات',
            ],
            'posts' => [
                'پست', 'پست ها', 'پست‌های گروه', 'وبلاگ گروه',
            ],
            'summary' => [
                'خلاصه گروه', 'وضعیت گروه', 'گزارش گروه', 'آمار گروه', 'همه چیز گروه',
            ],
        ];

        foreach ($intentMap as $intent => $keywords) {
            foreach ($keywords as $keyword) {
                if ($keyword !== '' && mb_stripos($plain, $keyword) !== false) {
                    return $intent;
                }
            }
        }

        return null;
    }

    protected function tryStructuredMetricQuery(string $text, Group $group, array $snapshot): ?string
    {
        $plain = mb_strtolower(trim($text));
        $isCountQuestion = str_contains($plain, 'چند') || str_contains($plain, 'تعداد') || str_contains($plain, 'count');
        if (!$isCountQuestion) {
            return null;
        }

        $members = $snapshot['members'] ?? [];
        $polls = $snapshot['polls'] ?? [];
        $elections = $snapshot['elections'] ?? [];
        $posts = $snapshot['posts'] ?? [];
        $messages = $snapshot['messages'] ?? [];
        $actionItems = $snapshot['action_items'] ?? [];

        if (str_contains($plain, 'مدیر')) {
            return "تعداد مدیران فعال گروه Â«{$group->name}»: " . (int) ($members['by_role']['manager'] ?? 0);
        }
        if (str_contains($plain, 'بازرس')) {
            return "تعداد بازرسان فعال گروه Â«{$group->name}»: " . (int) ($members['by_role']['inspector'] ?? 0);
        }
        if (str_contains($plain, 'ناظر')) {
            return "تعداد ناظران فعال گروه Â«{$group->name}»: " . (int) ($members['by_role']['observer'] ?? 0);
        }
        if (str_contains($plain, 'عضو')) {
            return "تعداد اعضای فعال گروه Â«{$group->name}»: " . (int) ($members['active'] ?? 0);
        }
        if (str_contains($plain, 'نظرسنج')) {
            return "تعداد نظرسنجی‌های فعال گروه Â«{$group->name}»: " . (int) ($polls['active'] ?? 0);
        }
        if (str_contains($plain, 'انتخابات داخلی')) {
            return "تعداد انتخابات داخلی فعال گروه Â«{$group->name}»: " . (int) ($elections['internal_active'] ?? 0);
        }
        if (str_contains($plain, 'انتخابات سیستمی')) {
            return "تعداد انتخابات سیستمی باز گروه Â«{$group->name}»: " . (int) ($elections['system_open'] ?? 0);
        }
        if (str_contains($plain, 'انتخابات')) {
            return "تعداد کل انتخابات گروه Â«{$group->name}»: " . ((int) ($elections['internal_total'] ?? 0) + (int) ($elections['system_total'] ?? 0));
        }
        if (str_contains($plain, 'پست')) {
            return "تعداد کل پست‌های گروه Â«{$group->name}»: " . (int) ($posts['total'] ?? 0);
        }
        if (str_contains($plain, 'پیام')) {
            return "تعداد پیام‌های امروز گروه Â«{$group->name}»: " . (int) ($messages['today'] ?? 0);
        }
        if (str_contains($plain, 'مصوبه')) {
            return "تعداد مصوبات باز گروه Â«{$group->name}»: " . (int) ($actionItems['open'] ?? 0);
        }

        return null;
    }

    protected function buildGroupFactsReply(Group $group, string $intent): string
    {
        $snapshot = $this->getGroupKnowledgeSnapshot($group);

        if ($intent === 'members') {
            $members = $snapshot['members'] ?? [];
            return implode("\n", [
                "آمار اعضای گروه Â«{$group->name}»:",
                "کل اعضا: " . ($members['total'] ?? 0),
                "اعضای فعال: " . ($members['active'] ?? 0),
                "ناظران: " . (($members['by_role']['observer'] ?? 0)),
                "فعال‌ها: " . (($members['by_role']['active'] ?? 0)),
                "بازرسان: " . (($members['by_role']['inspector'] ?? 0)),
                "مدیران: " . (($members['by_role']['manager'] ?? 0)),
            ]);
        }

        if ($intent === 'polls') {
            $polls = $snapshot['polls'] ?? [];
            $lines = [
                "وضعیت نظرسنجی‌های گروه Â«{$group->name}»:",
                "کل نظرسنجی‌ها: " . ($polls['total'] ?? 0),
                "نظرسنجی فعال: " . ($polls['active'] ?? 0),
                "نظرسنجی پایان‌یافته: " . ($polls['expired'] ?? 0),
                '',
                'آخرین نظرسنجی‌ها:',
            ];
            $recent = $polls['recent'] ?? [];
            if (empty($recent)) {
                $lines[] = '- موردی ثبت نشده است.';
            } else {
                foreach ($recent as $idx => $item) {
                    $lines[] = ($idx + 1) . ". " . ($item['question'] ?? '-') . " | " . ($item['status_label'] ?? '-');
                }
            }
            return implode("\n", $lines);
        }

        if ($intent === 'elections') {
            $elections = $snapshot['elections'] ?? [];
            $lines = [
                "وضعیت انتخابات گروه Â«{$group->name}»:",
                "کل انتخابات داخلی: " . ($elections['internal_total'] ?? 0),
                "انتخابات داخلی فعال: " . ($elections['internal_active'] ?? 0),
                "کل انتخابات سیستمی: " . ($elections['system_total'] ?? 0),
                "انتخابات سیستمی باز: " . ($elections['system_open'] ?? 0),
                '',
                'آخرین انتخابات:',
            ];
            $recent = $elections['recent'] ?? [];
            if (empty($recent)) {
                $lines[] = '- موردی ثبت نشده است.';
            } else {
                foreach ($recent as $idx => $item) {
                    $lines[] = ($idx + 1) . ". " . ($item['title'] ?? '-') . " | " . ($item['kind_label'] ?? '-') . " | " . ($item['status_label'] ?? '-');
                }
            }
            return implode("\n", $lines);
        }

        if ($intent === 'candidates') {
            $systemCandidates = $snapshot['elections']['system_current_candidates'] ?? [];
            $internalCandidates = $snapshot['elections']['internal_current_candidates'] ?? [];
            $lines = [
                "وضعیت کاندیداها در گروه Â«{$group->name}»:",
                '',
                'انتخابات سیستمی جاری:',
            ];

            if (empty($systemCandidates)) {
                $lines[] = '- انتخابات سیستمی جاری یا کاندیدای ثبت‌شده وجود ندارد.';
            } else {
                foreach ($systemCandidates as $idx => $cand) {
                    $lines[] = ($idx + 1) . ". " . ($cand['name'] ?? '-') .
                        " | رأی مدیر: " . ((int) ($cand['manager_votes'] ?? 0)) .
                        " | رأی بازرس: " . ((int) ($cand['inspector_votes'] ?? 0)) .
                        " | مجموع: " . ((int) ($cand['total_votes'] ?? 0));
                }
            }

            $lines[] = '';
            $lines[] = 'انتخابات داخلی جاری:';
            if (empty($internalCandidates)) {
                $lines[] = '- انتخابات داخلی جاری یا گزینه ثبت‌شده وجود ندارد.';
            } else {
                foreach ($internalCandidates as $idx => $cand) {
                    $lines[] = ($idx + 1) . ". " . ($cand['name'] ?? '-') . " | تعداد رأی: " . ((int) ($cand['votes'] ?? 0));
                }
            }

            return implode("\n", $lines);
        }

        if ($intent === 'posts') {
            $posts = $snapshot['posts'] ?? [];
            $lines = [
                "وضعیت پست‌های گروه Â«{$group->name}»:",
                "کل پست‌ها: " . ($posts['total'] ?? 0),
                "پست‌های این ماه: " . ($posts['this_month'] ?? 0),
                '',
                'آخرین پست‌ها:',
            ];
            $recent = $posts['recent'] ?? [];
            if (empty($recent)) {
                $lines[] = '- موردی ثبت نشده است.';
            } else {
                foreach ($recent as $idx => $item) {
                    $lines[] = ($idx + 1) . ". " . ($item['title'] ?? '-') . " | نویسنده: " . ($item['author'] ?? '-');
                }
            }
            return implode("\n", $lines);
        }

        if ($intent === 'summary') {
            $members = $snapshot['members'] ?? [];
            $polls = $snapshot['polls'] ?? [];
            $elections = $snapshot['elections'] ?? [];
            $posts = $snapshot['posts'] ?? [];
            $messages = $snapshot['messages'] ?? [];
            $actionItems = $snapshot['action_items'] ?? [];

            return implode("\n", [
                "خلاصه وضعیت گروه Â«{$group->name}»:",
                "اعضا: کل " . ($members['total'] ?? 0) . " | فعال " . ($members['active'] ?? 0) . " | مدیر " . (($members['by_role']['manager'] ?? 0)) . " | بازرس " . (($members['by_role']['inspector'] ?? 0)),
                "پیام‌ها: کل " . ($messages['total'] ?? 0) . " | امروز " . ($messages['today'] ?? 0) . " | این هفته " . ($messages['this_week'] ?? 0),
                "پست‌ها: کل " . ($posts['total'] ?? 0) . " | این ماه " . ($posts['this_month'] ?? 0),
                "نظرسنجی‌ها: کل " . ($polls['total'] ?? 0) . " | فعال " . ($polls['active'] ?? 0),
                "انتخابات داخلی: کل " . ($elections['internal_total'] ?? 0) . " | فعال " . ($elections['internal_active'] ?? 0),
                "انتخابات سیستمی: کل " . ($elections['system_total'] ?? 0) . " | باز " . ($elections['system_open'] ?? 0),
                "مصوبات: کل " . ($actionItems['total'] ?? 0) . " | باز " . ($actionItems['open'] ?? 0) . " | انجام شده " . ($actionItems['done'] ?? 0),
            ]);
        }

        return $this->buildLeadershipReply($group);
    }

    protected function buildLeadershipReply(Group $group): string
    {
        $leaders = $this->getGroupLeadershipContext($group);
        $managers = $leaders['managers'] ?? [];
        $inspectors = $leaders['inspectors'] ?? [];

        $lines = [
            "اطلاعات مدیریت گروه Â«{$group->name}»:",
            '',
            'مدیران گروه:',
        ];

        if (!empty($managers)) {
            foreach ($managers as $idx => $name) {
                $lines[] = ($idx + 1) . ". {$name}";
            }
        } else {
            $lines[] = '- مدیر فعالی ثبت نشده است.';
        }

        $lines[] = '';
        $lines[] = 'بازرسان گروه:';
        if (!empty($inspectors)) {
            foreach ($inspectors as $idx => $name) {
                $lines[] = ($idx + 1) . ". {$name}";
            }
        } else {
            $lines[] = '- بازرس فعالی ثبت نشده است.';
        }

        $lines[] = '';
        $lines[] = "تعداد اعضای فعال گروه: " . ($leaders['active_members_count'] ?? 0);

        return implode("\n", $lines);
    }

    protected function getGroupLeadershipContext(Group $group): array
    {
        $members = $group->users()
            ->select('users.id', 'users.first_name', 'users.last_name', 'users.email')
            ->withPivot('role', 'status')
            ->wherePivot('status', 1)
            ->get();

        $nameOf = function ($user): string {
            $full = trim(($user->first_name ?? '') . ' ' . ($user->last_name ?? ''));
            return $full !== '' ? $full : ($user->email ?? ('user#' . $user->id));
        };

        return [
            'managers' => $members->filter(fn ($u) => (int) $u->pivot->role === 3)->map($nameOf)->values()->all(),
            'inspectors' => $members->filter(fn ($u) => (int) $u->pivot->role === 2)->map($nameOf)->values()->all(),
            'active_members_count' => $members->count(),
        ];
    }

    protected function getGroupKnowledgeSnapshot(Group $group): array
    {
        $members = $group->users()
            ->select('users.id', 'users.first_name', 'users.last_name', 'users.email')
            ->withPivot('role', 'status')
            ->get();

        $activeMembers = $members->where('pivot.status', 1);
        $memberCountsByRole = [
            'observer' => $activeMembers->where('pivot.role', 0)->count(),
            'active' => $activeMembers->where('pivot.role', 1)->count(),
            'inspector' => $activeMembers->where('pivot.role', 2)->count(),
            'manager' => $activeMembers->where('pivot.role', 3)->count(),
            'guest' => $activeMembers->where('pivot.role', 4)->count(),
            'special_active' => $activeMembers->where('pivot.role', 5)->count(),
        ];

        $nameOf = function ($user): string {
            $full = trim(($user->first_name ?? '') . ' ' . ($user->last_name ?? ''));
            return $full !== '' ? $full : ($user->email ?? ('user#' . $user->id));
        };

        $recentPosts = \App\Models\Blog::query()
            ->where('group_id', $group->id)
            ->with('user:id,first_name,last_name,email')
            ->latest('id')
            ->take(5)
            ->get()
            ->map(function ($blog) use ($nameOf) {
                return [
                    'id' => $blog->id,
                    'title' => $blog->title,
                    'excerpt' => mb_substr(trim(strip_tags((string) $blog->content)), 0, 240),
                    'author' => $blog->user ? $nameOf($blog->user) : '-',
                    'at' => optional($blog->created_at)->toIso8601String(),
                ];
            })->values()->all();

        $pollsQuery = \App\Models\Poll::query()->where('group_id', $group->id)->where('main_type', 1);
        $pollsTotal = (clone $pollsQuery)->count();
        $pollsActive = (clone $pollsQuery)->where(function ($q) {
            $q->whereNull('expires_at')->orWhere('expires_at', '>', now());
        })->where(function ($q) {
            $q->whereNull('is_active')->orWhere('is_active', 1);
        })->count();
        $pollsExpired = max($pollsTotal - $pollsActive, 0);
        $recentPolls = (clone $pollsQuery)
            ->with(['options' => function ($q) {
                $q->withCount('votes');
            }])
            ->latest('id')
            ->take(5)
            ->get(['id', 'question', 'expires_at', 'is_active', 'created_at'])
            ->map(function ($poll) {
                $active = (is_null($poll->expires_at) || $poll->expires_at > now()) && ((int) ($poll->is_active ?? 1) === 1);
                return [
                    'id' => $poll->id,
                    'question' => $poll->question,
                    'status' => $active ? 'active' : 'expired',
                    'status_label' => $active ? 'فعال' : 'پایان‌یافته',
                    'options' => $poll->options->map(function ($option) {
                        return [
                            'text' => $option->text,
                            'votes' => (int) ($option->votes_count ?? 0),
                        ];
                    })->values()->all(),
                    'at' => optional($poll->created_at)->toIso8601String(),
                ];
            })->values()->all();

        $internalElectionQuery = \App\Models\Poll::query()->where('group_id', $group->id)->where('main_type', 0);
        $internalElectionTotal = (clone $internalElectionQuery)->count();
        $internalElectionActive = (clone $internalElectionQuery)->where(function ($q) {
            $q->whereNull('expires_at')->orWhere('expires_at', '>', now());
        })->count();

        $systemElectionQuery = \App\Models\Election::query()->where('group_id', $group->id);
        $systemElectionTotal = (clone $systemElectionQuery)->count();
        $systemElectionOpen = (clone $systemElectionQuery)->where('is_closed', 0)->count();

        $recentInternal = (clone $internalElectionQuery)->latest('id')->take(3)->get(['id', 'question', 'expires_at', 'created_at'])
            ->map(function ($row) {
                $active = is_null($row->expires_at) || $row->expires_at > now();
                return [
                    'title' => $row->question,
                    'kind' => 'internal',
                    'kind_label' => 'داخلی',
                    'status_label' => $active ? 'فعال' : 'پایان‌یافته',
                    'at' => optional($row->created_at)->toIso8601String(),
                ];
            });
        $recentSystem = (clone $systemElectionQuery)->latest('id')->take(3)->get(['id', 'is_closed', 'created_at'])
            ->map(function ($row) {
                return [
                    'title' => 'انتخابات سیستمی #' . $row->id,
                    'kind' => 'system',
                    'kind_label' => 'سیستمی',
                    'status_label' => ((int) $row->is_closed === 1) ? 'بسته' : 'باز',
                    'at' => optional($row->created_at)->toIso8601String(),
                ];
            });
        $recentElections = $recentInternal->concat($recentSystem)->sortByDesc('at')->take(5)->values()->all();

        $currentInternalElection = (clone $internalElectionQuery)
            ->where(function ($q) {
                $q->whereNull('expires_at')->orWhere('expires_at', '>', now());
            })
            ->latest('id')
            ->first();

        $internalCurrentCandidates = [];
        if ($currentInternalElection) {
            $internalCurrentCandidates = \App\Models\PollOption::query()
                ->where('poll_id', $currentInternalElection->id)
                ->withCount('votes')
                ->orderByDesc('votes_count')
                ->get()
                ->map(function ($option) {
                    return [
                        'name' => $option->text,
                        'votes' => (int) ($option->votes_count ?? 0),
                    ];
                })->values()->all();
        }

        $currentSystemElection = (clone $systemElectionQuery)
            ->where('is_closed', 0)
            ->latest('id')
            ->first();

        $systemCurrentCandidates = [];
        if ($currentSystemElection) {
            $voteCounts = \App\Models\Vote::query()
                ->selectRaw('candidate_id, position, COUNT(*) as c')
                ->where('election_id', $currentSystemElection->id)
                ->groupBy('candidate_id', 'position')
                ->get()
                ->groupBy('candidate_id');

            $candidates = \App\Models\Candidate::query()
                ->where('election_id', $currentSystemElection->id)
                ->with('user:id,first_name,last_name,email')
                ->get();

            $systemCurrentCandidates = $candidates->map(function ($candidate) use ($voteCounts, $nameOf) {
                $rows = $voteCounts->get($candidate->user_id, collect());
                $managerVotes = (int) (optional($rows->firstWhere('position', 1))->c ?? 0);
                $inspectorVotes = (int) (optional($rows->firstWhere('position', 0))->c ?? 0);
                $totalVotes = $managerVotes + $inspectorVotes;

                return [
                    'name' => $candidate->user ? $nameOf($candidate->user) : ('user#' . $candidate->user_id),
                    'manager_votes' => $managerVotes,
                    'inspector_votes' => $inspectorVotes,
                    'total_votes' => $totalVotes,
                ];
            })->sortByDesc('total_votes')->values()->all();
        }

        $messagesQuery = \App\Models\Message::query()->where('group_id', $group->id);
        $messagesTotal = (clone $messagesQuery)->count();
        $messagesToday = (clone $messagesQuery)->whereDate('created_at', today())->count();
        $messagesWeek = (clone $messagesQuery)->whereBetween('created_at', [now()->startOfWeek(), now()->endOfWeek()])->count();

        $actionItemsQuery = NajmHodaGroupActionItem::query()->where('group_id', $group->id);
        $actionTotal = (clone $actionItemsQuery)->count();
        $actionOpen = (clone $actionItemsQuery)->where('status', 'open')->count();
        $actionDone = (clone $actionItemsQuery)->where('status', 'done')->count();
        $actionOverdue = (clone $actionItemsQuery)->whereNotIn('status', ['done', 'cancelled'])->whereNotNull('due_at')->where('due_at', '<', now())->count();

        $reportsQuery = \App\Models\ReportedMessage::query()->where('group_id', $group->id);
        $reportsPending = (clone $reportsQuery)->where('status', 'pending_group_manager')->count();
        $reportsResolved = (clone $reportsQuery)->where('status', 'resolved_by_group_manager')->count();

        $mostActiveMembers = $group->users()
            ->select('users.id', 'users.first_name', 'users.last_name', 'users.email')
            ->withCount(['messages' => function ($query) use ($group) {
                $query->where('group_id', $group->id)->where('created_at', '>=', now()->subDays(30));
            }])
            ->orderBy('messages_count', 'desc')
            ->limit(5)
            ->get()
            ->map(function ($user) use ($nameOf) {
                return [
                    'name' => $nameOf($user),
                    'messages_30_days' => (int) ($user->messages_count ?? 0),
                ];
            })->values()->all();

        return [
            'members' => [
                'total' => $members->count(),
                'active' => $activeMembers->count(),
                'inactive' => $members->count() - $activeMembers->count(),
                'by_role' => $memberCountsByRole,
            ],
            'polls' => [
                'total' => $pollsTotal,
                'active' => $pollsActive,
                'expired' => $pollsExpired,
                'recent' => $recentPolls,
            ],
            'elections' => [
                'internal_total' => $internalElectionTotal,
                'internal_active' => $internalElectionActive,
                'system_total' => $systemElectionTotal,
                'system_open' => $systemElectionOpen,
                'recent' => $recentElections,
                'internal_current_candidates' => $internalCurrentCandidates,
                'system_current_candidates' => $systemCurrentCandidates,
            ],
            'posts' => [
                'total' => \App\Models\Blog::query()->where('group_id', $group->id)->count(),
                'this_month' => \App\Models\Blog::query()->where('group_id', $group->id)->whereMonth('created_at', now()->month)->whereYear('created_at', now()->year)->count(),
                'recent' => $recentPosts,
            ],
            'messages' => [
                'total' => $messagesTotal,
                'today' => $messagesToday,
                'this_week' => $messagesWeek,
            ],
            'action_items' => [
                'total' => $actionTotal,
                'open' => $actionOpen,
                'done' => $actionDone,
                'overdue' => $actionOverdue,
            ],
            'reports' => [
                'pending_group_manager' => $reportsPending,
                'resolved_by_group_manager' => $reportsResolved,
            ],
            'most_active_members_30_days' => $mostActiveMembers,
        ];
    }

    protected function sanitizeReply(string $text): string
    {
        $text = trim(strip_tags($text));
        if ($text === '') {
            return '';
        }

        return nl2br(e($text));
    }

    protected function tryHandlePrivateMessageCommand(
        Group $group,
        Message $trigger,
        NajmHodaGroupConfig $config,
        User $bot,
        string $cleanText
    ): ?array {
        if (!$this->hasPrivateMessageIntent($cleanText)) {
            return null;
        }

        $policy = is_array($config->policy) ? $config->policy : [];
        $allowPrivateMessages = (bool) ($policy['allow_private_messages'] ?? config('najm-hoda.group_assistant.allow_private_messages', true));
        $allowPrivateMessages = $allowPrivateMessages && (bool) config('najm-hoda.group_assistant.allow_private_messages', true);
        if (!$allowPrivateMessages) {
            return [
                'decision' => 'skipped',
                'reason' => 'private_message_disabled',
                'group_reply' => 'ارسال پیام خصوصی برای این گروه غیرفعال است.',
                'context' => ['source' => 'group_policy'],
            ];
        }

        $payload = $this->extractPrivateMessagePayload($group, $cleanText, $trigger, $bot->id);
        if ($payload === null) {
            return [
                'decision' => 'skipped',
                'reason' => 'private_message_target_not_found',
                'group_reply' => 'نام کاربر مقصد مشخص نشد. لطفا نام عضو را واضح بنویسید.',
                'context' => ['source' => 'intent_parse'],
            ];
        }

        $target = $payload['target'];
        $privateText = $payload['message'];
        if ((int) $target->id === (int) $bot->id) {
            return [
                'decision' => 'skipped',
                'reason' => 'private_message_invalid_target',
                'group_reply' => 'ارسال پیام خصوصی به خود نجم هدا ممکن نیست.',
                'context' => ['target_user_id' => $target->id],
            ];
        }

        $mode = (string) ($policy['private_message_mode'] ?? config('najm-hoda.group_assistant.private_message_mode', 'direct'));
        if (!in_array($mode, ['direct', 'request'], true)) {
            $mode = 'direct';
        }

        if ($mode === 'request') {
            $request = ChatRequest::query()
                ->where('sender_id', $bot->id)
                ->where('receiver_id', $target->id)
                ->first();

            if (!$request) {
                ChatRequest::create([
                    'sender_id' => $bot->id,
                    'receiver_id' => $target->id,
                    'message' => mb_substr($privateText, 0, 1000),
                    'status' => 'pending',
                ]);
            }

            return [
                'decision' => 'executed',
                'reason' => 'private_chat_request_sent',
                'group_reply' => "برای {$target->fullName()} درخواست گفتگوی خصوصی ارسال شد.",
                'context' => [
                    'mode' => 'request',
                    'target_user_id' => $target->id,
                ],
            ];
        }

        $privateGroup = $this->findOrCreatePrivateChatGroup($target, $bot);
        $directMessage = Message::create([
            'group_id' => $privateGroup->id,
            'user_id' => $bot->id,
            'message' => nl2br(e($privateText)),
        ]);
        event(new MessageCreated($directMessage, $privateGroup, $bot));

        return [
            'decision' => 'executed',
            'reason' => 'private_message_sent',
            'group_reply' => "پیام خصوصی برای {$target->fullName()} ارسال شد.",
            'context' => [
                'mode' => 'direct',
                'target_user_id' => $target->id,
                'private_group_id' => $privateGroup->id,
                'private_message_id' => $directMessage->id,
            ],
        ];
    }

    protected function hasPrivateMessageIntent(string $text): bool
    {
        $plain = mb_strtolower(trim($text));
        $keywords = [
            'پیام خصوصی',
            'پیوی',
            'pv',
            'دایرکت',
            'dm',
            'چت خصوصی',
            'درخواست چت',
        ];

        foreach ($keywords as $keyword) {
            if (mb_stripos($plain, $keyword) !== false) {
                return true;
            }
        }

        return false;
    }

    protected function extractPrivateMessagePayload(Group $group, string $text, Message $trigger, int $botUserId): ?array
    {
        $members = $group->users()
            ->select('users.id', 'users.first_name', 'users.last_name', 'users.email')
            ->withPivot('status')
            ->wherePivot('status', 1)
            ->get()
            ->filter(fn ($user) => (int) $user->id !== $botUserId)
            ->values();

        if ($members->isEmpty()) {
            return null;
        }

        $target = null;
        $normalizedText = mb_strtolower($text);
        foreach ($members->sortByDesc(fn ($u) => mb_strlen(trim($u->fullName()))) as $member) {
            $name = trim($member->fullName());
            if ($name === '') {
                continue;
            }
            if (mb_stripos($normalizedText, mb_strtolower($name)) !== false) {
                $target = $member;
                break;
            }
        }

        if (!$target) {
            return null;
        }

        $privateText = null;
        if (preg_match('/["â€œ](.+?)["â€]/u', $text, $m)) {
            $privateText = trim($m[1]);
        }
        if ($privateText === null || $privateText === '') {
            if (preg_match('/[\'\x{2018}\x{2019}](.+?)[\'\x{2018}\x{2019}]/u', $text, $m)) {
                $privateText = trim($m[1]);
            }
        }

        if ($privateText === null || $privateText === '') {
            $raw = trim(strip_tags((string) $trigger->message));
            $privateText = "پیام از طرف نجم هدا برای شما:\n" . mb_substr($raw, 0, 800);
        }

        return [
            'target' => $target,
            'message' => $privateText,
        ];
    }

    protected function findOrCreatePrivateChatGroup(User $target, User $bot): Group
    {
        $privateGroup = Group::query()
            ->where('group_type', 'private')
            ->whereHas('groupUser', function ($q) use ($target) {
                $q->where('user_id', $target->id)->where('status', 1);
            })
            ->whereHas('groupUser', function ($q) use ($bot) {
                $q->where('user_id', $bot->id)->where('status', 1);
            })
            ->withCount(['groupUser as active_members_count' => function ($q) {
                $q->where('status', 1);
            }])
            ->orderByDesc('id')
            ->get()
            ->first(function ($group) {
                return (int) ($group->active_members_count ?? 0) === 2;
            });

        if (!$privateGroup) {
            $privateGroup = Group::create([
                'name' => 'گفتگوی خصوصی ' . trim($target->fullName()),
                'description' => 'Private chat between Najm Hoda and ' . trim($target->fullName()),
                'group_type' => 'private',
                'location_level' => '10',
                'is_open' => 0,
            ]);
        }

        GroupUser::updateOrCreate(
            ['group_id' => $privateGroup->id, 'user_id' => $target->id],
            ['role' => 1, 'status' => 1, 'expired' => null]
        );

        GroupUser::updateOrCreate(
            ['group_id' => $privateGroup->id, 'user_id' => $bot->id],
            ['role' => 1, 'status' => 1, 'expired' => null]
        );

        return $privateGroup;
    }

    protected function tryHandleGroupActionCommand(
        Group $group,
        Message $trigger,
        NajmHodaGroupConfig $config,
        User $bot,
        string $cleanText
    ): ?array {
        $policy = $this->getActionExecutorPolicy($config);
        if (!(bool) ($policy['enabled'] ?? false)) {
            return null;
        }

        if (!$this->hasGroupActionIntent($cleanText)) {
            return null;
        }

        if (!$this->isActionRequesterAllowed($group, (int) $trigger->user_id, (array) ($policy['permitted_roles'] ?? [2, 3]))) {
            return [
                'decision' => 'skipped',
                'reason' => 'action_requester_not_allowed',
                'group_reply' => 'برای اجرای اکشن‌های گروهی دسترسی لازم را ندارید.',
                'context' => ['requester_user_id' => (int) $trigger->user_id],
            ];
        }

        $hourlyActions = NajmHodaGroupActionLog::query()
            ->where('group_id', $group->id)
            ->where('action_type', 'group_action_execute')
            ->where('decision', 'executed')
            ->where('created_at', '>=', now()->subHour())
            ->count();
        if ($hourlyActions >= (int) ($policy['max_actions_per_hour'] ?? 6)) {
            return [
                'decision' => 'skipped',
                'reason' => 'action_rate_limited',
                'group_reply' => 'سقف اجرای اکشن‌های خودکار این گروه در این ساعت پر شده است.',
                'context' => ['max_actions_per_hour' => (int) ($policy['max_actions_per_hour'] ?? 6)],
            ];
        }

        if ((bool) ($policy['propose_before_execute'] ?? false)) {
            return [
                'decision' => 'proposed',
                'reason' => 'propose_before_execute',
                'group_reply' => $this->buildGroupActionProposalReply($cleanText),
                'context' => ['mode' => 'proposal_only'],
            ];
        }

        $execution = $this->executeStructuredGroupAction($group, $trigger, $bot, $cleanText, $policy);
        if ($execution === null) {
            return [
                'decision' => 'skipped',
                'reason' => 'action_parse_failed',
                'group_reply' => 'دستور اکشن واضح نبود. لطفا با الگوی مشخص دستور بدهید (پست/نظرسنجی/کامنت/واکنش).',
                'context' => ['source' => 'parser'],
            ];
        }

        return $execution;
    }

    protected function getActionExecutorPolicy(NajmHodaGroupConfig $config): array
    {
        $policy = is_array($config->policy) ? $config->policy : [];
        $executor = is_array($policy['action_executor'] ?? null) ? $policy['action_executor'] : [];

        return [
            'enabled' => (bool) ($executor['enabled'] ?? config('najm-hoda.group_assistant.action_executor.enabled', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.enabled', true),
            'propose_before_execute' => (bool) ($executor['propose_before_execute'] ?? config('najm-hoda.group_assistant.action_executor.propose_before_execute', false))
                && (bool) config('najm-hoda.group_assistant.action_executor.propose_before_execute', false),
            'allow_create_post' => (bool) ($executor['allow_create_post'] ?? config('najm-hoda.group_assistant.action_executor.allow_create_post', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.allow_create_post', true),
            'allow_create_poll' => (bool) ($executor['allow_create_poll'] ?? config('najm-hoda.group_assistant.action_executor.allow_create_poll', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.allow_create_poll', true),
            'allow_create_comment' => (bool) ($executor['allow_create_comment'] ?? config('najm-hoda.group_assistant.action_executor.allow_create_comment', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.allow_create_comment', true),
            'allow_react_message' => (bool) ($executor['allow_react_message'] ?? config('najm-hoda.group_assistant.action_executor.allow_react_message', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.allow_react_message', true),
            'allow_react_post' => (bool) ($executor['allow_react_post'] ?? config('najm-hoda.group_assistant.action_executor.allow_react_post', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.allow_react_post', true),
            'allow_react_comment' => (bool) ($executor['allow_react_comment'] ?? config('najm-hoda.group_assistant.action_executor.allow_react_comment', true))
                && (bool) config('najm-hoda.group_assistant.action_executor.allow_react_comment', true),
            'max_actions_per_hour' => (int) config('najm-hoda.group_assistant.action_executor.max_actions_per_hour', (int) ($executor['max_actions_per_hour'] ?? 6)),
            'permitted_roles' => (array) ($executor['permitted_roles'] ?? config('najm-hoda.group_assistant.action_executor.permitted_roles', [2, 3])),
        ];
    }

    protected function hasGroupActionIntent(string $text): bool
    {
        return $this->inferGroupActionIntent($text) !== null;
    }

    protected function isActionRequesterAllowed(Group $group, int $requesterUserId, array $permittedRoles): bool
    {
        $role = GroupUser::query()
            ->where('group_id', $group->id)
            ->where('user_id', $requesterUserId)
            ->where('status', 1)
            ->value('role');

        $allowedRoles = array_map(fn ($r) => (int) $r, $permittedRoles);
        return in_array((int) $role, $allowedRoles, true);
    }

    protected function executeStructuredGroupAction(
        Group $group,
        Message $trigger,
        User $bot,
        string $text,
        array $policy
    ): ?array {
        $intent = $this->inferGroupActionIntent($text);
        if ($intent === 'create_post') {
            return $this->executeCreatePostAction($group, $trigger, $bot, $text, $policy);
        }

        if ($intent === 'create_poll') {
            return $this->executeCreatePollAction($group, $trigger, $bot, $text, $policy);
        }

        if ($intent === 'create_comment') {
            return $this->executeCreateCommentAction($group, $trigger, $bot, $text, $policy);
        }

        if ($intent === 'react') {
            $messageReaction = $this->executeMessageReactionAction($group, $trigger, $bot, $text, $policy);
            if ($messageReaction !== null) {
                return $messageReaction;
            }

            $postReaction = $this->executePostReactionAction($group, $trigger, $bot, $text, $policy);
            if ($postReaction !== null) {
                return $postReaction;
            }

            return $this->executeCommentReactionAction($group, $bot, $text, $policy);
        }

        return null;
    }

    protected function inferGroupActionIntent(string $text): ?string
    {
        $plain = $this->normalizeActionText($text);
        if ($plain === '') {
            return null;
        }

        $postNouns = ['post', 'پست'];
        $pollNouns = ['poll', 'vote', 'نظرسنجی', 'نظرسنجي', 'نظرسنچی', 'رای گیری', 'رای‌گیری'];
        $commentNouns = ['comment', 'کامنت', 'دیدگاه', 'نظر'];
        $reactionWords = ['react', 'reaction', 'like', 'dislike', 'واکنش', 'ری اکشن', 'ری‌اکشن', 'لایک', 'دیس', '❤️', '👍'];

        $createVerbs = ['create', 'publish', 'بساز', 'ایجاد', 'بذار', 'بگذار', 'بزار', 'ثبت کن', 'منتشر کن', 'برگزار کن', 'راه بنداز', 'راه بینداز', 'شروع کن'];
        $writeVerbs = ['write', 'add', 'بنویس', 'ثبت کن', 'بذار', 'بگذار', 'بزار'];
        $requestCues = ['لطفا', 'لطفاً', 'میشه', 'میشه', 'میتونی', 'می تونی', 'ممکنه', 'خواهش'];

        if ($this->containsAnyKeyword($plain, $reactionWords)) {
            return 'react';
        }
        if ($this->containsAnyKeyword($plain, $postNouns) && ($this->containsAnyKeyword($plain, $createVerbs) || $this->containsAnyKeyword($plain, $requestCues))) {
            return 'create_post';
        }
        if ($this->containsAnyKeyword($plain, $pollNouns) && ($this->containsAnyKeyword($plain, $createVerbs) || $this->containsAnyKeyword($plain, $requestCues))) {
            return 'create_poll';
        }
        if ($this->containsAnyKeyword($plain, $commentNouns) && ($this->containsAnyKeyword($plain, $writeVerbs) || $this->containsAnyKeyword($plain, $requestCues))) {
            return 'create_comment';
        }

        return null;
    }

    protected function containsAnyKeyword(string $plain, array $keywords): bool
    {
        foreach ($keywords as $keyword) {
            if ($keyword !== '' && mb_stripos($plain, (string) $keyword) !== false) {
                return true;
            }
        }

        return false;
    }

    protected function executeCreatePostAction(Group $group, Message $trigger, User $bot, string $text, array $policy): array
    {
        if (!(bool) ($policy['allow_create_post'] ?? true)) {
            return [
                'decision' => 'skipped',
                'reason' => 'create_post_disabled',
                'group_reply' => 'ایجاد پست توسط نجم هدا در این گروه غیرفعال است.',
                'context' => ['action' => 'create_post'],
            ];
        }

        $title = null;
        $content = null;

        if (preg_match('/عنوان\s*[:：]\s*(.+?)(?:\||\n|متن\s*[:：]|$)/u', $text, $m)) {
            $title = trim($m[1]);
        }
        if (preg_match('/متن\s*[:：]\s*(.+)$/us', $text, $m)) {
            $content = trim($m[1]);
        }

        if ($content === null || $content === '') {
            $content = trim(strip_tags((string) $trigger->message));
        }
        if ($this->isGenericPostCommand($content)) {
            $draft = $this->buildAutoPostDraft($group, $content);
            $title = $title ?: $draft['title'];
            $content = $draft['content'];
        }
        if ($title === null || $title === '') {
            $title = mb_substr($content, 0, 70);
        }

        $categoryId = Category::query()->orderBy('id')->value('id');
        if (!$categoryId) {
            return [
                'decision' => 'failed',
                'reason' => 'missing_post_category',
                'group_reply' => 'برای ایجاد پست، دسته‌بندی فعال یافت نشد.',
                'context' => ['action' => 'create_post'],
            ];
        }

        $post = Blog::create([
            'title' => $title,
            'content' => $content,
            'group_id' => $group->id,
            'user_id' => $bot->id,
            'category_id' => $categoryId,
        ]);
        event(new \App\Events\BlogCreated($post, $group, $bot));

        return [
            'decision' => 'executed',
            'reason' => 'post_created',
            'group_reply' => "پست جدید ثبت شد. شناسه پست: {$post->id}",
            'context' => ['action' => 'create_post', 'post_id' => $post->id],
        ];
    }

    protected function isGenericPostCommand(string $text): bool
    {
        $plain = $this->normalizeActionText($text);
        if ($plain === '') {
            return true;
        }

        $hasPostKeyword = str_contains($plain, 'پست') || str_contains($plain, 'post');
        $hasCommandKeyword =
            str_contains($plain, 'بذار')
            || str_contains($plain, 'بگذار')
            || str_contains($plain, 'بزار')
            || str_contains($plain, 'بساز')
            || str_contains($plain, 'ایجاد')
            || str_contains($plain, 'ثبت کن')
            || str_contains($plain, 'منتشر کن')
            || str_contains($plain, 'publish');

        return $hasPostKeyword && $hasCommandKeyword;
    }

    protected function buildAutoPostDraft(Group $group, string $prompt): array
    {
        $groupName = trim((string) ($group->name ?? 'گروه'));
        $today = verta(now())->format('Y/m/d');

        $title = "شروع هماهنگ همکاری در {$groupName}";
        $content = "سلام به اعضای {$groupName}\n\n"
            . "برای شروع هماهنگ‌تر فعالیت گروه، این چارچوب پیشنهادی را اجرا می‌کنیم:\n\n"
            . "1) هدف کوتاه‌مدت این هفته:\n"
            . "- هر عضو یک اولویت عملی Ùˆ قابل اندازه‌گیری پیشنهاد بدهد.\n\n"
            . "2) شفافیت در تصمیم‌گیری:\n"
            . "- جمع‌بندی تصمیم‌ها در قالب مصوبه ثبت می‌شود.\n"
            . "- مسئول هر مصوبه Ùˆ زمان انجام مشخص می‌شود.\n\n"
            . "3) مشارکت منظم:\n"
            . "- اگر نکته یا نقدی دارید، زیر همین پست ثبت کنید.\n"
            . "- اگر نیاز باشد نظرسنجی رسمی برگزار می‌کنیم.\n\n"
            . "4) مسیر اجرا:\n"
            . "- اولویت‌های جمع‌آوری‌شده، به برنامه اقدام گروه تبدیل می‌شود.\n\n"
            . "تاریخ ثبت: {$today}\n"
            . "نجم‌هدا";

        if (str_contains(mb_strtolower($prompt), 'آغاز')) {
            $title = "پست آغاز به کار {$groupName}";
        }

        return [
            'title' => $title,
            'content' => $content,
        ];
    }

    protected function executeCreatePollAction(Group $group, Message $trigger, User $bot, string $text, array $policy): array
    {
        if (!(bool) ($policy['allow_create_poll'] ?? true)) {
            return [
                'decision' => 'skipped',
                'reason' => 'create_poll_disabled',
                'group_reply' => 'ایجاد نظرسنجی توسط نجم هدا در این گروه غیرفعال است.',
                'context' => ['action' => 'create_poll'],
            ];
        }

        $question = null;
        if (preg_match('/(?:سوال|پرسش)\s*[:ï¼š]\s*(.+?)(?:\||\n|گزینه(?:â€Œ| )?ها?\s*[:：]|$)/u', $text, $m)) {
            $question = trim($m[1]);
        }

        $optionsRaw = null;
        if (preg_match('/گزینه(?:â€Œ| )?ها?\s*[:：]\s*(.+)$/us', $text, $m)) {
            $optionsRaw = trim($m[1]);
        }
        $options = [];
        if ($optionsRaw) {
            $parts = preg_split('/[,\|\nØ›;]/u', $optionsRaw) ?: [];
            foreach ($parts as $part) {
                $opt = trim($part);
                if ($opt !== '') {
                    $options[] = $opt;
                }
            }
        }

        if (($question === null || $question === '') && $this->isGenericPollCommand($text)) {
            $auto = $this->buildAutoPollDraft($group, $text);
            $question = $auto['question'];
            $options = $auto['options'];
        }
        if ($question === null || $question === '') {
            $question = $this->extractPollQuestionFromPrompt($text, $group);
            if ($question) {
                $options = ['موافقم', 'نیاز به بررسی بیشتر', 'مخالفم'];
            }
        }
        if ($question && count($options) < 2) {
            $options = ['موافقم', 'نیاز به بررسی بیشتر', 'مخالفم'];
        }

        if (!$question || count($options) < 2) {
            return [
                'decision' => 'skipped',
                'reason' => 'poll_payload_invalid',
                'group_reply' => 'فرمت نظرسنجی کامل نیست. مثال: «نجم‌هدا نظرسنجی بساز | سوال: ... | گزینه‌ها: گزینه۱، گزینه۲»',
                'context' => ['action' => 'create_poll'],
            ];
        }

        $days = 3;
        if (preg_match('/مهلت\s*[:：]\s*(\d+)/u', $text, $m)) {
            $days = max(1, min((int) $m[1], 90));
        }

        $poll = Poll::create([
            'group_id' => $group->id,
            'question' => $question,
            'is_multiple' => 0,
            'is_anonymous' => 0,
            'is_active' => 1,
            'show_results' => 1,
            'expires_at' => now()->addDays($days),
            'created_by' => $bot->id,
            'type' => 0,
            'main_type' => 1,
        ]);

        foreach ($options as $option) {
            PollOption::create([
                'poll_id' => $poll->id,
                'text' => $option,
            ]);
        }

        event(new \App\Events\PollCreated($poll, $group, $bot));

        return [
            'decision' => 'executed',
            'reason' => 'poll_created',
            'group_reply' => "نظرسنجی جدید ثبت شد. شناسه نظرسنجی: {$poll->id}",
            'context' => ['action' => 'create_poll', 'poll_id' => $poll->id, 'options_count' => count($options)],
        ];
    }

    protected function executeCreateCommentAction(Group $group, Message $trigger, User $bot, string $text, array $policy): ?array
    {
        if (!(bool) ($policy['allow_create_comment'] ?? true)) {
            return [
                'decision' => 'skipped',
                'reason' => 'create_comment_disabled',
                'group_reply' => 'ثبت کامنت توسط نجم هدا در این گروه غیرفعال است.',
                'context' => ['action' => 'create_comment'],
            ];
        }

        $postId = null;
        $plain = mb_strtolower($text);
        if (preg_match('/پست\s*#?(\d+)/u', $text, $postMatch)) {
            $postId = (int) $postMatch[1];
        } elseif (
            str_contains($plain, 'پست آخر')
            || str_contains($plain, 'آخرین پست')
            || str_contains($plain, 'پست جدید')
        ) {
            $postId = (int) Blog::query()
                ->where('group_id', $group->id)
                ->latest('id')
                ->value('id');
        } elseif (str_contains($plain, 'پستم') || str_contains($plain, 'پست من')) {
            $postId = (int) Blog::query()
                ->where('group_id', $group->id)
                ->where('user_id', (int) $trigger->user_id)
                ->latest('id')
                ->value('id');
        }
        if (!$postId) {
            return null;
        }

        $commentText = null;
        if (preg_match('/(?:کامنت|نظر).+?[:ï¼š]\s*(.+)$/us', $text, $m)) {
            $commentText = trim($m[1]);
        }
        if ($commentText === null || $commentText === '') {
            $commentText = "سپاس از انتشار این محتوا. لطفا اعضا نظر عملی خود را زیر همین پست ثبت کنند تا جمع‌بندی کنیم.";
        }

        $post = Blog::query()->where('id', $postId)->where('group_id', $group->id)->first();
        if (!$post) {
            return [
                'decision' => 'skipped',
                'reason' => 'post_not_found',
                'group_reply' => 'پست هدف در این گروه پیدا نشد.',
                'context' => ['action' => 'create_comment', 'post_id' => $postId],
            ];
        }

        $comment = Comment::create([
            'user_id' => $bot->id,
            'blog_id' => $post->id,
            'message' => $commentText,
        ]);
        event(new \App\Events\CommentCreated($comment, $post, $group, $bot));

        return [
            'decision' => 'executed',
            'reason' => 'comment_created',
            'group_reply' => "کامنت روی پست {$post->id} ثبت شد.",
            'context' => ['action' => 'create_comment', 'post_id' => $post->id, 'comment_id' => $comment->id],
        ];
    }

    protected function isGenericPollCommand(string $text): bool
    {
        $plain = $this->normalizeActionText($text);
        $hasPollKeyword = str_contains($plain, 'نظرسنجی') || str_contains($plain, 'نظرسنچی') || str_contains($plain, 'poll');
        $hasCommandKeyword =
            str_contains($plain, 'بساز')
            || str_contains($plain, 'ایجاد')
            || str_contains($plain, 'بذار')
            || str_contains($plain, 'بگذار')
            || str_contains($plain, 'بزار')
            || str_contains($plain, 'ثبت کن')
            || str_contains($plain, 'برگزار کن')
            || str_contains($plain, 'create');

        return $hasPollKeyword && $hasCommandKeyword;
    }

    protected function buildAutoPollDraft(Group $group, string $prompt): array
    {
        $groupName = trim((string) ($group->name ?? 'گروه'));
        $plain = mb_strtolower($prompt);

        $question = "برای شروع هماهنگ فعالیت‌ها در {$groupName}ØŒ با اولویت‌بندی سه اقدام اصلی موافقید؟";
        $options = ['موافقم', 'نیاز به اصلاح', 'مخالفم'];

        if (str_contains($plain, 'آغاز') || str_contains($plain, 'شروع')) {
            $question = "برای آغاز به‌کار {$groupName}ØŒ با برنامه پیشنهادی هفته اول موافقید؟";
        } elseif (str_contains($plain, 'مدیریت') || str_contains($plain, 'عملکرد')) {
            $question = "از روند مدیریت فعلی {$groupName} رضایت دارید؟";
            $options = ['بله', 'تا حدی', 'خیر'];
        }

        return [
            'question' => $question,
            'options' => $options,
        ];
    }

    protected function executeMessageReactionAction(Group $group, Message $trigger, User $bot, string $text, array $policy): ?array
    {
        $targetMessageId = null;
        $plain = mb_strtolower($text);

        if (preg_match('/پیام\s*#?(\d+)/u', $text, $idMatch)) {
            $targetMessageId = (int) $idMatch[1];
        } elseif (
            str_contains($plain, 'پیامم')
            || str_contains($plain, 'پیام من')
            || str_contains($plain, 'my message')
        ) {
            $targetMessageId = (int) Message::query()
                ->where('group_id', $group->id)
                ->where('user_id', (int) $trigger->user_id)
                ->where('id', '<>', (int) $trigger->id)
                ->latest('id')
                ->value('id');
        } elseif (
            str_contains($plain, 'این پیام')
            || str_contains($plain, 'همین پیام')
            || str_contains($plain, 'this message')
        ) {
            $targetMessageId = (int) ($trigger->parent_id ?: 0);
        }

        if (!$targetMessageId) {
            return null;
        }
        if (!(bool) ($policy['allow_react_message'] ?? true)) {
            return [
                'decision' => 'skipped',
                'reason' => 'react_message_disabled',
                'group_reply' => 'واکنش به پیام توسط نجم هدا غیرفعال است.',
                'context' => ['action' => 'react_message'],
            ];
        }

        $targetMessage = Message::query()
            ->where('id', $targetMessageId)
            ->where('group_id', $group->id)
            ->first();
        if (!$targetMessage) {
            return [
                'decision' => 'skipped',
                'reason' => 'message_not_found',
                'group_reply' => 'پیام هدف در این گروه پیدا نشد.',
                'context' => ['action' => 'react_message'],
            ];
        }

        $reactionType = $this->extractMessageReactionType($text);
        if (!$reactionType) {
            return [
                'decision' => 'skipped',
                'reason' => 'reaction_type_missing',
                'group_reply' => 'نوع واکنش پیام مشخص نیست.',
                'context' => ['action' => 'react_message', 'message_id' => $targetMessage->id],
            ];
        }

        MessageReaction::query()
            ->where('message_id', $targetMessage->id)
            ->where('user_id', $bot->id)
            ->delete();

        MessageReaction::create([
            'message_id' => $targetMessage->id,
            'user_id' => $bot->id,
            'reaction_type' => $reactionType,
        ]);

        return [
            'decision' => 'executed',
            'reason' => 'message_reacted',
            'group_reply' => "واکنش {$reactionType} روی پیام {$targetMessage->id} ثبت شد.",
            'context' => ['action' => 'react_message', 'message_id' => $targetMessage->id, 'reaction_type' => $reactionType],
        ];
    }

    protected function executePostReactionAction(Group $group, Message $trigger, User $bot, string $text, array $policy): ?array
    {
        $targetPostId = null;
        if (preg_match('/پست\s*#?(\d+)/u', $text, $idMatch)) {
            $targetPostId = (int) $idMatch[1];
        } elseif (
            str_contains(mb_strtolower($text), 'پستم')
            || str_contains(mb_strtolower($text), 'پست من')
            || str_contains(mb_strtolower($text), 'my post')
        ) {
            $targetPostId = (int) Blog::query()
                ->where('group_id', $group->id)
                ->where('user_id', (int) $trigger->user_id)
                ->latest('id')
                ->value('id');
        }
        if (!$targetPostId) {
            return null;
        }
        if (!(bool) ($policy['allow_react_post'] ?? true)) {
            return [
                'decision' => 'skipped',
                'reason' => 'react_post_disabled',
                'group_reply' => 'واکنش به پست توسط نجم هدا غیرفعال است.',
                'context' => ['action' => 'react_post'],
            ];
        }

        $post = Blog::query()->where('id', $targetPostId)->where('group_id', $group->id)->first();
        if (!$post) {
            return [
                'decision' => 'skipped',
                'reason' => 'post_not_found',
                'group_reply' => 'پست هدف در این گروه پیدا نشد.',
                'context' => ['action' => 'react_post'],
            ];
        }

        $type = $this->extractLikeDislikeType($text);
        if ($type === null) {
            return [
                'decision' => 'skipped',
                'reason' => 'reaction_type_missing',
                'group_reply' => 'برای پست فقط لایک/دیس‌لایک مشخص کنید.',
                'context' => ['action' => 'react_post', 'post_id' => $post->id],
            ];
        }

        Reaction::query()
            ->where('blog_id', $post->id)
            ->where('user_id', $bot->id)
            ->delete();

        Reaction::create([
            'blog_id' => $post->id,
            'user_id' => $bot->id,
            'type' => $type,
        ]);

        $label = $type === 1 ? 'لایک' : 'دیس‌لایک';
        return [
            'decision' => 'executed',
            'reason' => 'post_reacted',
            'group_reply' => "واکنش {$label} روی پست {$post->id} ثبت شد.",
            'context' => ['action' => 'react_post', 'post_id' => $post->id, 'type' => $type],
        ];
    }

    protected function executeCommentReactionAction(Group $group, User $bot, string $text, array $policy): ?array
    {
        if (!preg_match('/کامنت\s*#?(\d+)/u', $text, $idMatch) && !preg_match('/نظر\s*#?(\d+)/u', $text, $idMatch)) {
            return null;
        }
        if (!(bool) ($policy['allow_react_comment'] ?? true)) {
            return [
                'decision' => 'skipped',
                'reason' => 'react_comment_disabled',
                'group_reply' => 'واکنش به کامنت توسط نجم هدا غیرفعال است.',
                'context' => ['action' => 'react_comment'],
            ];
        }

        $comment = Comment::query()
            ->where('id', (int) $idMatch[1])
            ->whereHas('blog', fn ($q) => $q->where('group_id', $group->id))
            ->first();
        if (!$comment) {
            return [
                'decision' => 'skipped',
                'reason' => 'comment_not_found',
                'group_reply' => 'کامنت هدف در این گروه پیدا نشد.',
                'context' => ['action' => 'react_comment'],
            ];
        }

        $type = $this->extractLikeDislikeType($text);
        if ($type === null) {
            return [
                'decision' => 'skipped',
                'reason' => 'reaction_type_missing',
                'group_reply' => 'برای کامنت فقط لایک/دیس‌لایک مشخص کنید.',
                'context' => ['action' => 'react_comment', 'comment_id' => $comment->id],
            ];
        }

        Reaction::query()
            ->where('comment_id', $comment->id)
            ->where('user_id', $bot->id)
            ->delete();

        Reaction::create([
            'comment_id' => $comment->id,
            'user_id' => $bot->id,
            'type' => $type,
            'react_type' => 1,
        ]);

        $label = $type === 1 ? 'لایک' : 'دیس‌لایک';
        return [
            'decision' => 'executed',
            'reason' => 'comment_reacted',
            'group_reply' => "واکنش {$label} روی کامنت {$comment->id} ثبت شد.",
            'context' => ['action' => 'react_comment', 'comment_id' => $comment->id, 'type' => $type],
        ];
    }

    protected function extractMessageReactionType(string $text): ?string
    {
        $map = [
            'like' => 'like',
            'love' => 'love',
            'laugh' => 'laugh',
            'angry' => 'angry',
            'sad' => 'sad',
            'wow' => 'wow',
            'لایک' => 'like',
            'عشق' => 'love',
            'خنده' => 'laugh',
            'عصبانی' => 'angry',
            'غمگین' => 'sad',
            'واو' => 'wow',
        ];

        $plain = mb_strtolower($text);
        foreach ($map as $keyword => $reaction) {
            if (mb_stripos($plain, $keyword) !== false) {
                return $reaction;
            }
        }

        return null;
    }

    protected function extractLikeDislikeType(string $text): ?int
    {
        $plain = mb_strtolower($text);
        if (mb_stripos($plain, 'دیس') !== false || mb_stripos($plain, 'dislike') !== false) {
            return 0;
        }
        if (mb_stripos($plain, 'لایک') !== false || mb_stripos($plain, 'like') !== false) {
            return 1;
        }

        return null;
    }

    protected function buildGroupActionProposalReply(string $text): string
    {
        $plain = mb_strtolower(trim($text));

        if (str_contains($plain, 'نظرسنجی') || str_contains($plain, 'poll')) {
            return 'پیشنهاد: نظرسنجی جدید ثبت شود. برای اجرا، حالت «پیشنهاد قبل از اجرا» را خاموش کنید.';
        }
        if (str_contains($plain, 'پست') || str_contains($plain, 'post')) {
            return 'پیشنهاد: پست جدید در گروه منتشر شود. برای اجرا، حالت «پیشنهاد قبل از اجرا» را خاموش کنید.';
        }
        if (str_contains($plain, 'کامنت') || str_contains($plain, 'نظر')) {
            return 'پیشنهاد: کامنت جدید روی محتوای هدف ثبت شود. برای اجرا، حالت «پیشنهاد قبل از اجرا» را خاموش کنید.';
        }
        if (
            str_contains($plain, 'واکنش')
            || str_contains($plain, 'react')
            || str_contains($plain, 'لایک')
            || str_contains($plain, 'دیس')
            || str_contains($plain, 'like')
            || str_contains($plain, 'dislike')
        ) {
            return 'پیشنهاد: واکنش روی محتوای هدف ثبت شود. برای اجرا، حالت «پیشنهاد قبل از اجرا» را خاموش کنید.';
        }

        return 'پیشنهاد ثبت شد. برای اجرای خودکار، حالت «پیشنهاد قبل از اجرا» را غیرفعال کنید.';
    }

    protected function containsMeetingKeywords(string $plain): bool
    {
        $keywords = [
            'صورتجلسه',
            'صورت جلسه',
            'جمع بندی جلسه',
            'جمع‌بندی جلسه',
            'مصوبات',
            'جلسه را جمع بندی',
            'جلسه رو جمع بندی',
            'جلسه را مدیریت',
        ];

        foreach ($keywords as $keyword) {
            if (mb_stripos($plain, $keyword) !== false) {
                return true;
            }
        }

        return false;
    }

    protected function captureMeetingMemoryIfNeeded(
        int $groupId,
        Message $trigger,
        Message $response,
        NajmHodaGroupConfig $config
    ): void {
        if (!$config->meeting_mode_enabled) {
            return;
        }

        $plain = mb_strtolower(trim(strip_tags((string) $trigger->message)));
        if (!$this->containsMeetingKeywords($plain)) {
            return;
        }

        NajmHodaGroupMemory::create([
            'group_id' => $groupId,
            'memory_type' => 'meeting_minutes',
            'scope' => 'group',
            'content' => trim(strip_tags((string) $response->message)),
            'metadata' => [
                'trigger_message_id' => $trigger->id,
                'response_message_id' => $response->id,
            ],
            'captured_at' => now(),
        ]);
    }

    protected function extractAndStoreActionItemsIfNeeded(
        Group $group,
        Message $trigger,
        Message $response,
        NajmHodaGroupConfig $config,
        User $bot
    ): void {
        if (!(bool) config('najm-hoda.group_assistant.action_items.enabled', true)) {
            return;
        }

        $triggerText = mb_strtolower(trim(strip_tags((string) $trigger->message)));
        if (!$this->containsMeetingKeywords($triggerText) && !$this->containsActionKeywords($triggerText)) {
            return;
        }

        $items = $this->generateActionItems($group, $trigger, $response, $config);
        if (empty($items)) {
            return;
        }

        $saved = [];
        foreach ($items as $item) {
            if (empty($item['title'])) {
                continue;
            }

            $assignee = $this->resolveAssignee($group, (string) ($item['assignee_name'] ?? ''));
            $due = $this->normalizeDueDate($item['due_at'] ?? null);
            $priority = $this->normalizePriority($item['priority'] ?? 'medium');

            $saved[] = NajmHodaGroupActionItem::create([
                'group_id' => $group->id,
                'source_message_id' => $trigger->id,
                'response_message_id' => $response->id,
                'assigned_user_id' => $assignee?->id,
                'title' => trim((string) $item['title']),
                'details' => isset($item['details']) ? trim((string) $item['details']) : null,
                'assignee_name' => $assignee?->fullName() ?: (isset($item['assignee_name']) ? trim((string) $item['assignee_name']) : null),
                'due_at' => $due,
                'due_text' => isset($item['due_at']) ? trim((string) $item['due_at']) : null,
                'priority' => $priority,
                'status' => 'open',
                'meta' => [
                    'generator' => 'najm_hoda_group_assistant',
                    'knowledge_scope' => $config->knowledge_scope,
                ],
            ]);
        }

        if (empty($saved)) {
            return;
        }

        $summary = $this->buildActionItemsSummaryMessage($saved);
        $summaryMessage = Message::create([
            'group_id' => $group->id,
            'user_id' => $bot->id,
            'message' => $summary,
            'parent_id' => (string) $response->id,
            'thread_id' => $response->thread_id ?: $response->id,
        ]);
        event(new MessageCreated($summaryMessage, $group, $bot));

        $this->logAction($group->id, $trigger->id, $summaryMessage->id, 'meeting_action_items', 'executed', 'guide', 'action_items_created', [
            'count' => count($saved),
        ]);
    }

    protected function containsActionKeywords(string $plain): bool
    {
        $keywords = [
            'اقدام',
            'اقدامات',
            'پیگیری',
            'تسک',
            'task',
            'مصوبه',
            'مصوبات',
            'مسئول انجام',
            'ددلاین',
            'مهلت',
        ];

        foreach ($keywords as $keyword) {
            if (mb_stripos($plain, $keyword) !== false) {
                return true;
            }
        }

        return false;
    }

    protected function generateActionItems(
        Group $group,
        Message $trigger,
        Message $response,
        NajmHodaGroupConfig $config
    ): array {
        $recent = Message::query()
            ->where('group_id', $group->id)
            ->latest('id')
            ->take(40)
            ->get(['id', 'user_id', 'message', 'created_at'])
            ->reverse()
            ->map(function (Message $m) {
                return [
                    'id' => $m->id,
                    'user_id' => $m->user_id,
                    'text' => trim(strip_tags((string) $m->message)),
                    'at' => optional($m->created_at)->toIso8601String(),
                ];
            })
            ->values()
            ->all();

        $prompt = "شما دبیر جلسه هستید. از گفت‌وگوی زیر، فقط آیتم‌های اقدام قابل اجرا استخراج کن.

قواعد:
1) فقط اقدام‌های مشخص Ùˆ قابل اجرا را برگردان.
2) حداکثر " . (int) config('najm-hoda.group_assistant.action_items.max_items', 8) . " آیتم.
3) اگر مسئول مشخص نیست، assignee_name را خالی بگذار.
4) اگر تاریخ دقیق نیست، due_at را خالی بگذار Ùˆ due_text را متن طبیعی بگذار.
5) خروجی فقط JSON معتبر باشد.

فرمت:
{
  \"items\": [
    {
      \"title\": \"\",
      \"details\": \"\",
      \"assignee_name\": \"\",
      \"due_at\": \"YYYY-MM-DD\",
      \"priority\": \"low|medium|high\"
    }
  ]
}

متن درخواست اصلی:
" . trim(strip_tags((string) $trigger->message)) . "

پاسخ دبیر:
" . trim(strip_tags((string) $response->message)) . "

بخش‌هایی از گفت‌وگو:
" . json_encode($recent, JSON_UNESCAPED_UNICODE);

        $orchestrator = app(NajmHodaOrchestrator::class);
        $result = $orchestrator->route($prompt, [
            'force_agent' => 'guide',
            'group_assistant_mode' => true,
            'group_id' => $group->id,
            'knowledge_scope' => $config->knowledge_scope,
            'response_format' => 'json',
        ]);

        if (!($result['success'] ?? false)) {
            return [];
        }

        $payload = $this->decodeJsonPayload((string) ($result['message'] ?? ''));
        $items = $payload['items'] ?? [];
        if (!is_array($items)) {
            return [];
        }

        return array_slice(array_values(array_filter($items, fn ($item) => is_array($item))), 0, (int) config('najm-hoda.group_assistant.action_items.max_items', 8));
    }

    protected function decodeJsonPayload(string $content): array
    {
        $content = trim($content);
        if ($content === '') {
            return [];
        }

        $normalized = preg_replace('/```json\s*(.*?)\s*```/is', '$1', $content);
        $normalized = preg_replace('/```\s*(.*?)\s*```/is', '$1', (string) $normalized);
        $normalized = trim((string) $normalized);

        $decoded = json_decode($normalized, true);
        if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
            return $decoded;
        }

        if (preg_match('/\{.*\}/s', $normalized, $m)) {
            $decoded = json_decode($m[0], true);
            if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
                return $decoded;
            }
        }

        return [];
    }

    protected function resolveAssignee(Group $group, string $assigneeName): ?User
    {
        $name = trim($assigneeName);
        if ($name === '') {
            return null;
        }

        return $group->users()
            ->where(function ($q) use ($name) {
                $q->where('first_name', 'like', '%' . $name . '%')
                    ->orWhere('last_name', 'like', '%' . $name . '%')
                    ->orWhereRaw("CONCAT(first_name, ' ', last_name) LIKE ?", ['%' . $name . '%']);
            })
            ->first();
    }

    protected function normalizeDueDate(mixed $value): ?Carbon
    {
        if (!is_string($value) || trim($value) === '') {
            return null;
        }

        try {
            return Carbon::parse($value)->endOfDay();
        } catch (\Throwable) {
            return null;
        }
    }

    protected function normalizePriority(mixed $value): string
    {
        $priority = mb_strtolower(trim((string) $value));
        return in_array($priority, ['low', 'medium', 'high'], true) ? $priority : 'medium';
    }

    protected function buildActionItemsSummaryMessage(array $saved): string
    {
        $lines = ["âœ… آیتم‌های پیگیری جلسه ثبت شد:"];
        foreach ($saved as $index => $item) {
            $assignee = $item->assignee_name ? " | مسئول: {$item->assignee_name}" : '';
            $due = $item->due_text ? " | مهلت: {$item->due_text}" : '';
            $lines[] = ($index + 1) . ". {$item->title}{$assignee}{$due}";
        }
        $lines[] = "برای ادامه، می‌تونیم وضعیت اجرای هر مورد رو هم مرحله‌ای پیگیری کنیم.";

        return nl2br(e(implode("\n", $lines)));
    }

    protected function tryHandleModerationCommand(
        Group $group,
        Message $trigger,
        NajmHodaGroupConfig $config,
        User $bot,
        string $cleanText
    ): ?array {
        $plain = mb_strtolower($cleanText);
        $hasModerationIntent = str_contains($plain, 'پاکسازی')
            || str_contains($plain, 'پاک کن')
            || str_contains($plain, 'حذف پیام')
            || str_contains($plain, 'پیام بی')
            || str_contains($plain, 'بی ارتباط')
            || str_contains($plain, 'نامرتبط');

        if (!$hasModerationIntent) {
            return null;
        }

        if (!$this->isActionRequesterAllowed($group, (int) $trigger->user_id, [2, 3])) {
            return [
                'decision' => 'skipped',
                'reason' => 'moderation_requester_not_allowed',
                'group_reply' => 'برای مدیریت پاکسازی پیام‌های گروه، دسترسی مدیر/بازرس لازم است.',
                'context' => ['requester_user_id' => (int) $trigger->user_id],
            ];
        }

        $policy = is_array($config->policy) ? $config->policy : [];
        $moderation = is_array($policy['moderation'] ?? null) ? $policy['moderation'] : [];
        $currentInterval = max(1, (int) ($moderation['cleanup_interval_hours'] ?? 24));

        $isDisable = str_contains($plain, 'خاموش') || str_contains($plain, 'غیرفعال') || str_contains($plain, 'توقف');
        if ($isDisable) {
            $moderation['enabled'] = false;
            $moderation['auto_cleanup_enabled'] = false;
            $moderation['next_cleanup_at'] = null;
            $moderation['last_cleanup_at'] = (string) now()->toIso8601String();
            $policy['moderation'] = $moderation;
            $config->policy = $policy;
            $config->save();

            return [
                'decision' => 'executed',
                'reason' => 'moderation_schedule_disabled',
                'group_reply' => 'پاکسازی خودکار پیام‌های بی‌ارتباط خاموش شد.',
                'context' => ['interval_hours' => $currentInterval],
            ];
        }

        $requestedHours = $this->extractCleanupIntervalHours($plain);
        $isScheduleIntent = str_contains($plain, 'هر')
            || str_contains($plain, 'روزانه')
            || str_contains($plain, '۲۴')
            || str_contains($plain, '24');
        if ($isScheduleIntent) {
            $hours = $requestedHours ?? $currentInterval;
            $hours = max(1, min($hours, 168));
            $moderation['enabled'] = true;
            $moderation['auto_cleanup_enabled'] = true;
            $moderation['cleanup_interval_hours'] = $hours;
            $moderation['next_cleanup_at'] = (string) now()->addHours($hours)->toIso8601String();
            $policy['moderation'] = $moderation;
            $config->policy = $policy;
            $config->save();

            return [
                'decision' => 'executed',
                'reason' => 'moderation_schedule_enabled',
                'group_reply' => "پاکسازی خودکار پیام‌های بی‌ارتباط فعال شد Ùˆ هر {$hours} ساعت اجرا می‌شود.",
                'context' => ['interval_hours' => $hours],
            ];
        }

        $result = $this->runIrrelevantMessageCleanup($group, $config, $bot, true);
        return [
            'decision' => 'executed',
            'reason' => 'moderation_cleanup_manual',
            'group_reply' => "پاکسازی انجام شد. {$result['cleaned']} پیام بی‌ارتباط علامت‌گذاری/حذف شد.",
            'context' => $result,
        ];
    }

    protected function extractCleanupIntervalHours(string $plain): ?int
    {
        $normalized = $this->normalizeActionText($plain);
        if (preg_match('/هر\s*(\d{1,3})\s*ساعت/u', $normalized, $m)) {
            return (int) $m[1];
        }
        if (str_contains($normalized, 'روزانه') || str_contains($normalized, 'هر روز')) {
            return 24;
        }
        if (preg_match('/هر\s*(\d{1,3})\s*روز/u', $normalized, $m)) {
            return max(1, (int) $m[1]) * 24;
        }

        return null;
    }
    public function runScheduledModerationSweep(int $maxGroups = 100): array
    {
        $bot = $this->ensureBotUser();
        $processed = 0;
        $cleanedTotal = 0;

        $configs = NajmHodaGroupConfig::query()
            ->where('enabled', true)
            ->whereNotNull('policy')
            ->take($maxGroups)
            ->get();

        foreach ($configs as $config) {
            $policy = is_array($config->policy) ? $config->policy : [];
            $moderation = is_array($policy['moderation'] ?? null) ? $policy['moderation'] : [];
            if (!(bool) ($moderation['enabled'] ?? false) || !(bool) ($moderation['auto_cleanup_enabled'] ?? false)) {
                continue;
            }

            $nextAtRaw = (string) ($moderation['next_cleanup_at'] ?? '');
            if ($nextAtRaw !== '') {
                try {
                    if (Carbon::parse($nextAtRaw)->isFuture()) {
                        continue;
                    }
                } catch (\Throwable) {
                }
            }

            $group = Group::query()->find($config->group_id);
            if (!$group) {
                continue;
            }

            $result = $this->runIrrelevantMessageCleanup($group, $config, $bot, false);
            $processed++;
            $cleanedTotal += (int) ($result['cleaned'] ?? 0);
        }

        return [
            'processed_groups' => $processed,
            'cleaned_messages' => $cleanedTotal,
        ];
    }

    protected function runIrrelevantMessageCleanup(Group $group, NajmHodaGroupConfig $config, User $bot, bool $manual): array
    {
        $policy = is_array($config->policy) ? $config->policy : [];
        $moderation = is_array($policy['moderation'] ?? null) ? $policy['moderation'] : [];
        $strictness = (string) ($moderation['strictness'] ?? 'balanced');
        $maxPerRun = max(5, min((int) ($moderation['max_messages_per_run'] ?? 30), 200));
        $windowHours = max(6, min((int) ($moderation['scan_window_hours'] ?? 24), 240));

        $topicKeywords = $this->buildGroupTopicKeywords($group);
        $messages = Message::query()
            ->where('group_id', $group->id)
            ->whereNull('removed_by')
            ->where('created_at', '>=', now()->subHours($windowHours))
            ->where('user_id', '<>', $bot->id)
            ->orderByDesc('id')
            ->take(300)
            ->get();

        $cleaned = 0;
        $scanned = 0;
        foreach ($messages as $message) {
            if ($cleaned >= $maxPerRun) {
                break;
            }
            $scanned++;

            $role = GroupUser::query()
                ->where('group_id', $group->id)
                ->where('user_id', $message->user_id)
                ->where('status', 1)
                ->value('role');
            if (in_array((int) $role, [2, 3], true)) {
                continue;
            }
            if (!empty($message->parent_id)) {
                continue;
            }
            if ($this->isMessageIrrelevant((string) $message->message, $topicKeywords, $strictness)) {
                $message->removed_by = $bot->id;
                $message->save();
                $cleaned++;
            }
        }

        $interval = max(1, min((int) ($moderation['cleanup_interval_hours'] ?? 24), 168));
        $moderation['enabled'] = (bool) ($moderation['enabled'] ?? true);
        $moderation['last_cleanup_at'] = (string) now()->toIso8601String();
        if ((bool) ($moderation['auto_cleanup_enabled'] ?? false)) {
            $moderation['next_cleanup_at'] = (string) now()->addHours($interval)->toIso8601String();
        }
        $policy['moderation'] = $moderation;
        $config->policy = $policy;
        $config->save();

        $this->logAction(
            $group->id,
            null,
            null,
            'message_cleanup',
            'executed',
            'steward',
            $manual ? 'manual_cleanup' : 'scheduled_cleanup',
            [
                'cleaned' => $cleaned,
                'scanned' => $scanned,
                'window_hours' => $windowHours,
                'strictness' => $strictness,
            ]
        );

        return [
            'cleaned' => $cleaned,
            'scanned' => $scanned,
            'window_hours' => $windowHours,
            'manual' => $manual,
        ];
    }

    protected function buildGroupTopicKeywords(Group $group): array
    {
        $seedTexts = [];
        $seedTexts[] = (string) $group->name;

        $recentPosts = Blog::query()
            ->where('group_id', $group->id)
            ->latest('id')
            ->take(15)
            ->get(['title', 'content']);
        foreach ($recentPosts as $post) {
            $seedTexts[] = (string) $post->title;
            $seedTexts[] = (string) $post->content;
        }

        $recentPolls = Poll::query()
            ->where('group_id', $group->id)
            ->latest('id')
            ->take(15)
            ->pluck('question')
            ->all();
        $seedTexts = array_merge($seedTexts, $recentPolls);

        $terms = [];
        foreach ($seedTexts as $text) {
            $tokens = $this->tokenizeText($text);
            foreach ($tokens as $token) {
                $terms[$token] = ($terms[$token] ?? 0) + 1;
            }
        }

        arsort($terms);
        return array_slice(array_keys($terms), 0, 80);
    }

    protected function isMessageIrrelevant(string $message, array $topicKeywords, string $strictness = 'balanced'): bool
    {
        $plain = trim(mb_strtolower(strip_tags($message)));
        if ($plain === '') {
            return true;
        }

        $trivialPatterns = [
            'سلام', 'خوبی', 'اوکی', 'ok', 'مرسی', 'ممنون', 'صبح بخیر', 'شب بخیر',
            'lol', 'ðŸ˜‚', 'ðŸ¤£', 'ðŸ‘', 'â¤ï¸',
        ];
        foreach ($trivialPatterns as $pattern) {
            if (mb_stripos($plain, $pattern) !== false && mb_strlen($plain) <= 40) {
                return true;
            }
        }

        $tokens = $this->tokenizeText($plain);
        if (count($tokens) === 0) {
            return true;
        }

        $topicSet = array_fill_keys($topicKeywords, true);
        $overlap = 0;
        foreach ($tokens as $token) {
            if (isset($topicSet[$token])) {
                $overlap++;
            }
        }

        if ($strictness === 'strict') {
            return $overlap === 0;
        }
        if ($strictness === 'lenient') {
            return $overlap === 0 && mb_strlen($plain) < 35;
        }

        return $overlap === 0 && mb_strlen($plain) < 70;
    }

    protected function tokenizeText(string $text): array
    {
        $text = mb_strtolower($text);
        $text = preg_replace('/[^\p{L}\p{N}\s]+/u', ' ', $text) ?? '';
        $parts = preg_split('/\s+/u', $text, -1, PREG_SPLIT_NO_EMPTY) ?: [];

        $stopWords = [
            'از', 'به', 'در', 'با', 'برای', 'این', 'اون', 'آن', 'که', 'را', 'Ùˆ', 'یا', 'روی',
            'من', 'تو', 'شما', 'ما', 'یک', 'دو', 'سه', 'خیلی', 'فقط', 'هم', 'همه', 'است', 'هست',
            'the', 'and', 'or', 'to', 'of', 'a', 'an', 'is', 'are', 'for', 'in', 'on',
        ];
        $stop = array_fill_keys($stopWords, true);

        $out = [];
        foreach ($parts as $token) {
            if (mb_strlen($token) < 3) {
                continue;
            }
            if (isset($stop[$token])) {
                continue;
            }
            $out[] = $token;
        }

        return array_values(array_unique($out));
    }

    protected function extractPollQuestionFromPrompt(string $text, Group $group): ?string
    {
        $plain = $this->normalizeActionText($text);
        $removeTokens = [
            'نجم هدا', 'نجم‌هدا', 'لطفا', 'لطفاً', 'میشه', 'میتونی', 'می تونی',
            'نظرسنجی', 'نظرسنچی', 'poll', 'بساز', 'ایجاد', 'بذار', 'بگذار', 'بزار', 'ثبت کن', 'برگزار کن',
        ];
        foreach ($removeTokens as $token) {
            $plain = str_replace($token, ' ', $plain);
        }
        $plain = trim(preg_replace('/\s+/u', ' ', $plain) ?? '');
        if ($plain === '' || mb_strlen($plain) < 6) {
            return null;
        }

        return "درباره «{$plain}» نظر اعضای گروه چیست؟";
    }

    protected function normalizeActionText(string $text): string
    {
        $plain = mb_strtolower(trim($text));
        $plain = str_replace(
            ['ي', 'ك', 'ۀ', 'ة', '‌', 'ـ', 'أ', 'إ', 'ٱ'],
            ['ی', 'ک', 'ه', 'ه', ' ', ' ', 'ا', 'ا', 'ا'],
            $plain
        );
        $plain = strtr($plain, [
            '۰' => '0', '۱' => '1', '۲' => '2', '۳' => '3', '۴' => '4',
            '۵' => '5', '۶' => '6', '۷' => '7', '۸' => '8', '۹' => '9',
            '٠' => '0', '١' => '1', '٢' => '2', '٣' => '3', '٤' => '4',
            '٥' => '5', '٦' => '6', '٧' => '7', '٨' => '8', '٩' => '9',
        ]);
        $plain = preg_replace('/\s+/u', ' ', $plain) ?? $plain;

        return trim($plain);
    }

    protected function platformCapabilitiesSummary(): array
    {
        return [
            'group_chat' => 'Group chat, reply, and mention handling',
            'private_chat' => 'Private member messaging with policy control',
            'group_posts' => 'Create and manage group posts',
            'group_polls' => 'Create and manage polls inside groups',
            'support_tickets' => 'Escalate complex issues to support tickets',
            'najm_bahar' => 'Guide members to financial workflows in Najm Bahar',
            'knowledge_base' => 'Use project knowledge for contextual guidance',
        ];
    }

    protected function platformPrinciples(): array
    {
        return [
            'justice' => 'Fair and unbiased guidance',
            'participation' => 'Encourage active participation',
            'transparency' => 'Transparent reasoning and communication',
            'non_manipulative_guidance' => 'Ethical non-coercive guidance aligned with platform goals',
        ];
    }
    protected function getCrossGroupInsights(NajmHodaGroupConfig $config): array
    {
        if (!in_array($config->knowledge_scope, ['hybrid', 'global'], true)) {
            return [];
        }

        $recentDecisions = NajmHodaGroupActionLog::query()
            ->where('decision', 'executed')
            ->where('created_at', '>=', now()->subDays(14))
            ->selectRaw('action_type, count(*) as c')
            ->groupBy('action_type')
            ->pluck('c', 'action_type')
            ->toArray();

        $recentMeetingMemories = NajmHodaGroupMemory::query()
            ->where('memory_type', 'meeting_minutes')
            ->where('created_at', '>=', now()->subDays(30))
            ->count();

        return [
            'scope' => $config->knowledge_scope,
            'executed_actions_last_14_days' => $recentDecisions,
            'meeting_minutes_count_last_30_days' => $recentMeetingMemories,
            'privacy_note' => 'بینش‌ها تجمیعی هستند Ùˆ داده خام گروه‌های دیگر افشا نمی‌شود.',
        ];
    }

    protected function logAction(
        int $groupId,
        ?int $triggerMessageId,
        ?int $responseMessageId,
        string $actionType,
        string $decision,
        ?string $agent,
        ?string $reason,
        array $context = []
    ): void {
        NajmHodaGroupActionLog::create([
            'group_id' => $groupId,
            'trigger_message_id' => $triggerMessageId,
            'response_message_id' => $responseMessageId,
            'action_type' => $actionType,
            'decision' => $decision,
            'agent' => $agent,
            'reason' => $reason,
            'context' => $context,
        ]);
    }
}



