# Copy to .env on the VPS. Never commit the real .env.
N8N_HOST=n8n-staging.example.org
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n-staging.example.org
WEBHOOK_URL=https://n8n-staging.example.org/
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran

# Generate strong random values on the VPS.
N8N_ENCRYPTION_KEY=CHANGE_ME_64_PLUS_RANDOM_CHARS
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Shared with EarthCoop staging only. Never expose in browser/workflow output.
NAJM_HODA_N8N_SHARED_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES

# EarthCoop staging callback endpoint. Keep callback ingress disabled in Laravel
# until outbound health and staging GameDay prerequisites pass.
EARTHCOOP_CALLBACK_URL=https://staging.example.org/api/najm-hoda/n8n/callback
