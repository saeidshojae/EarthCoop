  function cancelelectionForm(){











    document.querySelector('#back').style='display: none'











    document.querySelector('#electionOptionsBox').style='display: none'











  }











  











    // ??ï¿½????????? ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ?????????????? ??ï¿½??ï¿½ ????????????ï¿½????? ??ï¿½??ï¿½??ï¿½ ????????????????ï¿½??????ï¿½ scroll ??ï¿½??ï¿½ chat.blade.php ??ï¿½??ï¿½??ï¿½??ï¿½????? ??ï¿½??ï¿½??ï¿½??ï¿½











    // window.addEventListener('DOMContentLoaded', function () {











    //     const chatBox = document.getElementById('chat-box');











    //     chatBox.scrollTop = chatBox.scrollHeight;











    // });











    























    // ??ï¿½??ï¿½??ï¿½ ??ï¿½????? ??ï¿½??ï¿½ scroll restore ??ï¿½??ï¿½?????????? ??ï¿½??????ï¿½ ???????ï¿½????? ??ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½ polling











    // ??ï¿½????????? ??????????????? ??ï¿½??ï¿½??ï¿½ ?????????????? polling ???????ï¿½??ï¿½??????ï¿½ ????????????????ï¿½??????ï¿½ scroll ??ï¿½??ï¿½ ??ï¿½??ï¿½??????????ï¿½ ??ï¿½???????ï¿½ ???????ï¿½????? ??ï¿½??ï¿½ ??ï¿½???????????ï¿½????? restore ??ï¿½??????ï¿½











    let pollingStarted = false;











    let lastMessageId = null;











    let renderedMessageIds = new Set(); // ??ï¿½??ï¿½??ï¿½????????? ??ï¿½??????ï¿½????? ID ??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½??????ï¿½??ï¿½??ï¿½ ??ï¿½???????ï¿½ ??ï¿½??????ï¿½?????ï¿½????????????ï¿½???? ??ï¿½??ï¿½??????ï¿½











    let pollingInterval = null;











        if (pollingDebug) {











            console.warn(...args);











        }






















    











    // ??ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½??????ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½????????? message ID ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½?????











    function getLastMessageId() {











        if (renderedMessageIds && renderedMessageIds.size) {











            return Math.max(...renderedMessageIds);











        }























        const chatBox = document.getElementById('chat-box');











        if (!chatBox) {            return null;











        }























        const messages = chatBox.querySelectorAll('[data-message-id]');











        if (messages.length === 0) {            return null;











        }























        let maxId = 0;











        messages.forEach(msg => {











            const msgId = parseInt(msg.getAttribute('data-message-id'));











            if (msgId && !isNaN(msgId) && msgId > maxId) {











                maxId = msgId;











                if (renderedMessageIds) {











                    renderedMessageIds.add(msgId);











                }











            }











        });























        return maxId > 0 ? maxId : null;











    }











    











    // ??ï¿½??ï¿½??ï¿½??????ï¿½ startPolling ??ï¿½??ï¿½ scope global ??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½ DOMContentLoaded











    window.startPolling = function startPolling() {











        const runtimeConfig = getChatRuntimeConfig();











        if (!runtimeConfig.enabled) {











            return;











        }























        if (pollingStarted) {











            return;











        }











        











        // ??ï¿½??ï¿½??ï¿½??ï¿½???? ??????ï¿½??????ï¿½ groupId - ??ï¿½???????ï¿½ ??ï¿½??ï¿½ window.groupId ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½????? ?????????ï¿½???????ï¿½??????????????











        if (typeof window.groupId === 'undefined' || !window.groupId) {











            console.error('ï¿½?? window.groupId not found! Cannot start polling. window.groupId:', window.groupId);











            return;











        }











        











        const currentGroupId = window.groupId;











        // ??ï¿½??ï¿½??????ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½????????? message ID ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½????? ??ï¿½??ï¿½?????????











        lastMessageId = getLastMessageId();











        renderedMessageIds = new Set(Array.from(document.querySelectorAll('[data-message-id]')).map(el => parseInt(el.getAttribute('data-message-id'))).filter(id => !isNaN(id)));











        // ??ï¿½??ï¿½??ï¿½??ï¿½???? ??ï¿½????? ??ï¿½????? ??ï¿½??????ï¿½ scroll restore ??ï¿½??ï¿½????? ??ï¿½??ï¿½??ï¿½











        // ??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ 5 ??ï¿½??ï¿½?????????????? ????????????????ï¿½ restore ???????ï¿½??ï¿½????????? polling ??ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½ ??ï¿½?????











        let attempts = 0;











        const maxAttempts = 10;











        const checkInterval = setInterval(function() {











            attempts++;











            if (window.scrollPositionRestored || attempts >= maxAttempts) {











                clearInterval(checkInterval);











                pollingStarted = true;











                // ??ï¿½??ï¿½???????ï¿½ polling ??ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½ ??ï¿½????? - ???????ï¿½ 1.5 ??ï¿½??ï¿½?????????????? ??????ï¿½??ï¿½??ï¿½??ï¿½











                const pollingIntervalMs = resolvePollingIntervalMs();











                pollingInterval = setInterval(function() {











                    // ??ï¿½??ï¿½??????ï¿½??ï¿½??ï¿½ groupId ??ï¿½??ï¿½ window











                    if (typeof window.groupId === 'undefined' || !window.groupId) {











                        console.error('ï¿½?? window.groupId not found during polling!');











                        return;











                    }











                    











                    const currentGroupId = window.groupId;











                    syncPostFeed(currentGroupId);











                    if (!window.__lastReconcileAt || Date.now() - window.__lastReconcileAt > 30000) {











                        window.__lastReconcileAt = Date.now();











