async function submitPostEdit(event, postId) {











    event.preventDefault();























    const titleInput = document.getElementById(`edit-post-title-${postId}`);











    const contentInput = document.getElementById(`edit-post-content-${postId}`);











    const categorySelect = document.getElementById(`edit-post-category-${postId}`);























    const title = titleInput?.value || '';











    const content = contentInput?.value || '';











    const categoryId = categorySelect?.value || '';























    if (!title.trim() || !content.trim() || !categoryId) {











        alert('Please complete all required fields.');











        return;











    }























    try {











        const response = await fetch(`/blog/${postId}`, {











            method: 'PUT',











            headers: {











                'Content-Type': 'application/json',











                'X-CSRF-TOKEN': getCsrfToken(),











                'Accept': 'application/json',











                'X-Requested-With': 'XMLHttpRequest'











            },











            body: JSON.stringify({











                title: title,











                content: content,











                category_id: categoryId











            })











        });























        const data = await response.json();























        if (!response.ok) {











            if (response.status === 422 && data?.errors) {











                const messages = Object.values(data.errors).flat().join('\n');











                alert(messages || 'Validation failed.');











                return;











            }











            throw new Error(data.message || 'Error updating post');











        }























        if (data.status !== 'success') {











            alert(data.message || 'Error updating post');











            return;











        }























        const postCard = document.getElementById(`blog-${postId}`);











        if (postCard) {











            const titleEl = postCard.querySelector('.post-card__title');











            const contentEl = postCard.querySelector('.post-card__content');











            const categoryAnchor = postCard.querySelector('.post-card__category a.open-category-blogs');











            const categoryWrap = postCard.querySelector('.post-card__category');











            const categoryName = categorySelect.options?.[categorySelect.selectedIndex]?.text || '';























            if (titleEl) {











                titleEl.textContent = title;











            } else if (title.trim()) {











                const metaEl = postCard.querySelector('.post-card__meta');











                if (metaEl) {











                    const h3 = document.createElement('h3');











                    h3.className = 'post-card__title';











                    h3.textContent = title;











                    postCard.insertBefore(h3, metaEl);











                }











            }























            if (contentEl) {











                contentEl.innerHTML = content;











            }























            if (categoryAnchor) {











                categoryAnchor.textContent = categoryName;











                categoryAnchor.dataset.url = `/categories/${categoryId}/blogs`;











            } else if (categoryWrap) {











                categoryWrap.innerHTML = `<i class="fas fa-folder-open"></i> ${categoryName}`;











            }











        }























        const modalElement = document.getElementById(`editPostModal-${postId}`);











        if (modalElement && typeof bootstrap !== 'undefined' && bootstrap.Modal) {











            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);











            modalInstance.hide();











        }











    } catch (error) {











        console.error('Error:', error);











        alert(error.message || 'Server error');











    }











}























function openChatSearch() {











    const searchBox = document.createElement('div');











    searchBox.className = 'chat-search-box';











    searchBox.innerHTML = `











        <div class="search-header">











            <input type="text" id="chatSearchInput" placeholder="??ï¿½??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½ ??ï¿½??????ï¿½?????ï¿½????????????ï¿½...">











            <button onclick="closeChatSearch()">?????</button>











        </div>











        <div id="searchResults" class="search-results"></div>











    `;











    document.body.appendChild(searchBox);











    











    const searchInput = document.getElementById('chatSearchInput');











    searchInput.focus();











    











    let searchTimeout;











    searchInput.addEventListener('input', function() {











        clearTimeout(searchTimeout);











        searchTimeout = setTimeout(() => {











            const searchTerm = this.value.toLowerCase();











            const messages = document.querySelectorAll('.message-wrapper');











            const results = [];











            const seenIds = new Set();











            











            messages.forEach(msg => {











                const messageId = msg.getAttribute('data-message-id');











                if (seenIds.has(messageId)) return;











                seenIds.add(messageId);











                











                const content = msg.querySelector('.message-bubble p')?.textContent.toLowerCase() || '';











                if (content.includes(searchTerm)) {











                    results.push(msg);











                }











            });











            











            const resultsContainer = document.getElementById('searchResults');











            resultsContainer.innerHTML = '';











            











            results.forEach(msg => {











                const clone = msg.cloneNode(true);











                clone.addEventListener('click', () => {











                    msg.scrollIntoView({ behavior: 'smooth', block: 'center' });











                    msg.style.backgroundColor = '#ffeb3b';











                    setTimeout(() => msg.style.backgroundColor = '', 2000);











                });











                resultsContainer.appendChild(clone);











            });











        }, 300); // ??ï¿½??ï¿½??ï¿½??????ï¿½ 300 ??????????????????ï¿½???????ï¿½??ï¿½?????????????? ??ï¿½??ï¿½??ï¿½???? ??ï¿½???????????ï¿½??????ï¿½???? ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½???????? ???????ï¿½??ï¿½??ï¿½











    });











}























function closeChatSearch() {











    const searchBox = document.querySelector('.chat-search-box');











    if (searchBox) {











        searchBox.remove();











    }











}























