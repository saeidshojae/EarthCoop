                                }











                                // ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½????? ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½ appendMessage ??ï¿½????? ???????ï¿½???????ï¿½????? ??ï¿½??ï¿½??ï¿½??????ï¿½ ??ï¿½??ï¿½?????











                                if (typeof appendMessage === 'function') {











