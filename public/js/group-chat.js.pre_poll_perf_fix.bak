                                    'X-CSRF-TOKEN': getCsrfToken(),











                                    'Accept': 'application/json'











                                },











                                body: formData











                            });























                            const responseData = await safeReadJson(response);























                            if (!response.ok) {











                                if (response.status === 422) {











                                    const errorMessage = responseData.message || '??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½???????ï¿½???? ??ï¿½??ï¿½??ï¿½?????ï¿½????????????ï¿½';











                                    const errors = responseData.errors ? Object.values(responseData.errors).flat().join('\n') : '';











                                    alert(`${errorMessage}\n${errors}`);











                                } else if (response.status === 500) {











                                    console.error('Server Error Details:', responseData);











                                    alert('??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½. ???????ï¿½??ï¿½??ï¿½????? ??ï¿½??????ï¿½??ï¿½??ï¿½????? ??ï¿½???????ï¿½??ï¿½ ??ï¿½???????????ï¿½. ??ï¿½??ï¿½??ï¿½ ???????ï¿½??ï¿½????? ??ï¿½??ï¿½??ï¿½?????????? ??ï¿½??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??????ï¿½??ï¿½????????? ??ï¿½???????ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½??????ï¿½.');











                                } else {











                                    throw new Error(`HTTP error! status: ${response.status}`);











                                }











                            }











                            











                            if (responseData.status === 'success') {











                                appendMessage(responseData.message);











                                form.reset();











                            } else {











                                alert('??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½????? ??ï¿½??????ï¿½????? ??ï¿½??????ï¿½????: ' + (responseData.message || '??ï¿½??ï¿½??ï¿½???? ???????ï¿½??ï¿½???????ï¿½??ï¿½??ï¿½?????'));











                            }











                        } catch (error) {











                            console.error('Error:', error);











                            if (error.message.includes('Failed to fetch')) {











                                alert('??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½????? ??ï¿½????? ??ï¿½??ï¿½??????ï¿½. ???????ï¿½??ï¿½??ï¿½????? ??ï¿½??ï¿½??ï¿½??ï¿½????? ??ï¿½???????????ï¿½??ï¿½???????ï¿½ ??ï¿½??????ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½???? ??ï¿½???????????ï¿½.');











                            } else {











                                alert('??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½????? ??ï¿½??????ï¿½????? ??ï¿½??????ï¿½????. ???????ï¿½??ï¿½??ï¿½????? ??ï¿½??????ï¿½??ï¿½??ï¿½????? ??ï¿½???????ï¿½??ï¿½ ??ï¿½???????????ï¿½.');











                            }











                        }











                    }











                }











            };











        };











        











        mediaRecorder.start();











