    // ========== END POLLING MECHANISM ==========











});























function appendMessage(message) {











    const chatBox = document.getElementById('chat-box');











    if (!chatBox) return;











    if (!message || !message.id) return;











    if (isMessageRendered(message.id)) return;











    if (renderedMessageIds) {











        renderedMessageIds.add(message.id);











    }























    const isMine = message.user_id == authUserId;











    const senderName = message.sender || '??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½';











    const initials = senderName.split(' ').map(n => n.charAt(0)).join(' ').trim() || '???';











    // ???????ï¿½??ï¿½??????ï¿½ ??ï¿½??ï¿½ backend ??ï¿½??ï¿½ <br> ??ï¿½??ï¿½??ï¿½???? line breaks ?????????ï¿½???????ï¿½??????ï¿½???? ???????ï¿½??ï¿½????????????????ï¿½????? ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½????? ?????????ï¿½???????ï¿½??????????????











    const messageContent = message.message || '';











