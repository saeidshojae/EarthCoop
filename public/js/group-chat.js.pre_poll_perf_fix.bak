            } else {











                alert(response.message || '??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??????????ï¿½??ï¿½??????ï¿½ ??ï¿½??????ï¿½?????');











            }











        },











        error: function() {











            alert('??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½');











        }











    });











}























