  });











    }











    if ($('#inspector_vote').length && !$('#inspector_vote').data('select2')) {











  $('#inspector_vote').select2({











    multiple: true,











    placeholder: "??ï¿½???????ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½???????????ï¿½",











    dir: "rtl",











  });











    }











  }























  $('#electionForm').on('submit', function (e) {











    const inspectorSelectedCount = $('#inspector_vote').val()?.length || 0;











    const managerSelectedCount   = $('#manager_vote').val()?.length || 0;











    if (inspectorSelectedCount > inspectorCount) {











      e.preventDefault();











      showWarningAlert(`??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½????????????????ï¿½????? ${inspectorCount} ??ï¿½??ï¿½?????????????? ??ï¿½???????ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½???????????ï¿½.`);











      return;











    }











  











    if (managerSelectedCount > manageCount) {











      e.preventDefault();











      showWarningAlert(`??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½ ???????ï¿½??????ï¿½ ??ï¿½????????????????ï¿½????? ${manageCount} ??ï¿½??ï¿½?????????????? ??ï¿½???????ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½???????????ï¿½.`);











      return;











    }











  











    // ???????????????ï¿½????????????????ï¿½ ??ï¿½??????ï¿½???? => ??ï¿½??ï¿½????? ??ï¿½??ï¿½??ï¿½??ï¿½????? ?????????ï¿½???????ï¿½?????











  });











  























  























});























function openElectionBox(){











  const overlay = document.getElementById('electionVotingOverlay');











  if (overlay) {











    // Move overlay to body if not already there











    if (overlay.parentElement !== document.body) {











      document.body.appendChild(overlay);











    }











    overlay.style.display = 'flex';











    document.body.style.overflow = 'hidden';











    // Scroll to top of overlay











    overlay.scrollTop = 0;











    











    // Trigger event ??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½??????ï¿½??ï¿½??ï¿½??ï¿½????????? Select2 ??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½????? ???????ï¿½??ï¿½?????











    setTimeout(function() {











      if (typeof window.updateElectionSelect2 === 'function') {











        window.updateElectionSelect2();











      }











      // Dispatch custom event ??ï¿½??ï¿½??ï¿½???? ??ï¿½??ï¿½???????ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½ ??ï¿½??ï¿½???????ï¿½











      try {











        const event = new Event('electionModalOpened');











        window.dispatchEvent(event);











      } catch(e) {











        // Fallback for older browsers











        try {











          var event = document.createEvent('Event');











          event.initEvent('electionModalOpened', true, true);











          window.dispatchEvent(event);











        } catch(e2) {











          console.error('Error dispatching event:', e2);











        }











      }











    }, 600);











  }











  closeGroupInfo();











}























function closeElectionBox(){











  const overlay = document.getElementById('electionVotingOverlay');











  if (overlay) {











    overlay.style.display = 'none';











    document.body.style.overflow = '';











  }











}























// Close election modal on Escape key











document.addEventListener('keydown', function(e) {











  if (e.key === 'Escape') {











    const overlay = document.getElementById('electionVotingOverlay');











    if (overlay && overlay.style.display === 'flex') {











      closeElectionBox();











    }











  }











});























let postReactionDelegatedHandlerInstalled = false;











function initPostReactionActions() {











  if (postReactionDelegatedHandlerInstalled) return;











  postReactionDelegatedHandlerInstalled = true;























  document.addEventListener('click', function (event) {











    const likeButton = event.target.closest('.reaction-buttons .btn-like');











    const dislikeButton = event.target.closest('.reaction-buttons .btn-dislike');











    const button = likeButton || dislikeButton;











    if (!button) return;























    const container = button.closest('.reaction-buttons');











    const blogId = container?.dataset?.postId;











    if (!container || !blogId) return;























    event.preventDefault();











    const reactionType = likeButton ? '1' : '0';











    sendReaction(blogId, reactionType, container);











  });











}











document.addEventListener('DOMContentLoaded', initPostReactionActions);























  











function sendReaction(blogId, type, container) {











  $.ajax({











    url: `/blogs/${blogId}/react`,











    method: 'POST',











    data: {











      type: type,











      _token: getCsrfToken()











    },











    success: function (data) {











      if (data.status === 'success') {











        updatePostReactionUi(blogId, data.likes, data.dislikes, type);











      } else {











        showErrorAlert(data.message || '??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½ ??????ï¿½??ï¿½???????ï¿½');











      }











    },











    error: function () {











      showErrorAlert('ï¿½?? ??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ ??ï¿½??ï¿½??????ï¿½');











    }











  });











}























function updatePostReactionUi(postId, likes, dislikes, activeType = null) {











  const container = document.querySelector(`.reaction-buttons[data-post-id="${postId}"]`);











  if (!container) return;























  const likeCountEl = container.querySelector('.like-count');











  const dislikeCountEl = container.querySelector('.dislike-count');











  const likeBtn = container.querySelector('.btn-like');











  const dislikeBtn = container.querySelector('.btn-dislike');























  if (likeCountEl && typeof likes !== 'undefined') {











    likeCountEl.textContent = String(likes);











  }











  if (dislikeCountEl && typeof dislikes !== 'undefined') {











    dislikeCountEl.textContent = String(dislikes);











  }























  if (activeType === '1') {











    likeBtn?.classList.add('active');











    dislikeBtn?.classList.remove('active');











  } else if (activeType === '0') {











    dislikeBtn?.classList.add('active');











    likeBtn?.classList.remove('active');











  }











}























function isRichTextEmpty(html) {











  if (html == null) return true;











  const normalized = String(html)











    .replace(/<br\s*\/?>/gi, ' ')











    .replace(/<\/p>/gi, ' ')











    .replace(/<[^>]+>/g, ' ')











    .replace(/&nbsp;/gi, ' ')











    .replace(/\s+/g, '')











    .trim();











  return normalized.length === 0;











}























function setButtonLoadingState(button, isLoading, loadingText) {











  if (!button) return;























  if (isLoading) {











    if (!button.dataset.originalHtml) {











      button.dataset.originalHtml = button.innerHTML;











    }











    button.disabled = true;











    button.setAttribute('aria-busy', 'true');











    button.innerHTML = `<i class="fas fa-spinner fa-spin" style="margin-left:6px;"></i>${loadingText || '?? ??? ?????...'}`;











    return;











  }























  button.disabled = false;











  button.removeAttribute('aria-busy');











  if (button.dataset.originalHtml) {











    button.innerHTML = button.dataset.originalHtml;











  }











}











function wireFeedCreateForms() {











    const postForm = document.getElementById('postForm');











  if (postForm && !postForm.dataset.ajaxBound) {











    postForm.dataset.ajaxBound = '1';











    postForm.addEventListener('submit', async function (event) {











      event.preventDefault();























      const submitBtn = postForm.querySelector('button[type="submit"]');











      if (submitBtn?.dataset.inFlight === '1') {











        return;











      }























      let editorContent = '';











      if (window.CKEDITOR?.instances?.post_editor) {











        const postEditor = window.CKEDITOR.instances.post_editor;











        postEditor.updateElement();











        editorContent = postEditor.getData() || '';











      } else {











        editorContent = document.getElementById('post_editor')?.value || '';











      }























      if (isRichTextEmpty(editorContent)) {











        showErrorAlert('??? ??? ?????? ???.');











        return;











      }























      const formData = new FormData(postForm);











      formData.set('content', editorContent);























      try {











        if (submitBtn) {











          submitBtn.dataset.inFlight = '1';











          setButtonLoadingState(submitBtn, true, '?? ??? ??????...');











        }























        const response = await fetch(postForm.action, {











          method: 'POST',











          headers: {











            'Accept': 'application/json',











            'X-Requested-With': 'XMLHttpRequest',











            'X-CSRF-TOKEN': getCsrfToken()











          },











          body: formData,











          credentials: 'same-origin'











        });











        const data = await safeReadJson(response);











        if (!response.ok || data.status !== 'success') {











          if (response.status === 422 && data?.errors) {











            const messages = Object.values(data.errors).flat().join('\n');











            throw new Error(messages || data.message || '??? ?? ?????????? ???');











          }











          throw new Error(data.message || '??? ?? ????? ???');











        }























        if (data?.post?.html) {











          applyGroupFeedUpdate({











            action: 'post_created',











            payload: {











              post_id: data.post.id,











              html: data.post.html











            }











          });











        }























        postForm.reset();











        if (window.CKEDITOR?.instances?.post_editor) {











          window.CKEDITOR.instances.post_editor.setData('');











        }











        if (typeof window.cancelPostForm === 'function') {











          window.cancelPostForm();











        }











      } catch (error) {











        showErrorAlert(error.message || '??? ?? ????? ???');











      } finally {











        if (submitBtn) {











          submitBtn.dataset.inFlight = '0';











          setButtonLoadingState(submitBtn, false);











        }











      }











    });











  }























  const pollForm = document.getElementById('pollForm');











  if (pollForm && !pollForm.dataset.ajaxBound) {











    pollForm.dataset.ajaxBound = '1';











    pollForm.addEventListener('submit', async function (event) {











      event.preventDefault();











      const formData = new FormData(pollForm);























      try {











        const response = await fetch(pollForm.action, {











          method: 'POST',











          headers: {











            'Accept': 'application/json',











            'X-Requested-With': 'XMLHttpRequest',











            'X-CSRF-TOKEN': getCsrfToken()











          },











          body: formData,











          credentials: 'same-origin'











        });











        const data = await safeReadJson(response);











        if (!response.ok || data.status !== 'success') {











          throw new Error(data.message || '??? ?? ?????? ??????????');











        }























        if (data?.poll?.html) {











          applyGroupFeedUpdate({











            action: 'poll_created',











            payload: {











              poll_id: data.poll.id,











              html: data.poll.html











            }











          });











        }























        pollForm.reset();











        const pollType = document.getElementById('poll_type');











        const specialtiesBox = document.getElementById('specialties_box');











        if (pollType) pollType.value = '0';











        if (specialtiesBox) specialtiesBox.style.display = 'none';











        const optionsContainer = document.getElementById('dynamic-inputs');











        if (optionsContainer) {











          optionsContainer.innerHTML = '<input type="text" name="options[]" placeholder="???????? 1" class="modal-input mb-2" />';











        }











        if (typeof window.cancelPollForm === 'function') {











          window.cancelPollForm();











        }











      } catch (error) {











        showErrorAlert(error.message || '??? ?? ?????? ??????????');











      }











    });











  }























  if (!document.body.dataset.pollEditAjaxBound) {











    document.body.dataset.pollEditAjaxBound = '1';











    document.addEventListener('submit', async function (event) {











      const form = event.target.closest('.post-edit-form form[action*="/poll/"]');











      if (!form) return;























      event.preventDefault();











      const formData = new FormData(form);























      try {











        const response = await fetch(form.action, {











          method: 'POST',











          headers: {











            'Accept': 'application/json',











            'X-Requested-With': 'XMLHttpRequest',











            'X-CSRF-TOKEN': getCsrfToken()











          },











          body: formData,











          credentials: 'same-origin'











        });











        const data = await safeReadJson(response);











        if (!response.ok || data.status !== 'success') {











          throw new Error(data.message || '??? ?? ????????? ??????????');











        }























        if (data?.poll?.html) {











          applyGroupFeedUpdate({











            action: 'poll_updated',











            payload: {











              poll_id: data.poll.id,











              html: data.poll.html











            }











          });











        }











      } catch (error) {











        showErrorAlert(error.message || '??? ?? ????????? ??????????');











      }











    });











  }











}











document.addEventListener('DOMContentLoaded', wireFeedCreateForms);















































function openGroupInfo() {











  const panel = document.getElementById('groupInfoPanel');











  const backdrop = document.getElementById('groupInfoBackdrop');











  if (!panel) return;























  if (window.innerWidth < 1024) {











    panel.classList.add('is-open');











    if (backdrop) {











      backdrop.classList.remove('hidden');











      backdrop.classList.add('group-info-backdrop--visible');











    }











  }











}























function closeGroupInfo() {











  const panel = document.getElementById('groupInfoPanel');











  const backdrop = document.getElementById('groupInfoBackdrop');











  if (!panel) return;























  panel.classList.remove('is-open');











  if (backdrop) {











    backdrop.classList.add('hidden');











    backdrop.classList.remove('group-info-backdrop--visible');











  }











}























document.getElementById('groupInfoBackdrop')?.addEventListener('click', closeGroupInfo);











window.addEventListener('resize', () => {











  if (window.innerWidth >= 1024) {











    closeGroupInfo();











  }











});











document.addEventListener('keydown', (event) => {











  if (event.key === 'Escape') {











    closeGroupInfo();











  }











});























document.addEventListener('DOMContentLoaded', () => {











  const closeAllMenus = (except = null) => {











    document.querySelectorAll('[data-action-menu]').forEach(menu => {











      if (menu !== except) {











        menu.classList.remove('is-open');











        menu.querySelector('.action-menu__toggle')?.setAttribute('aria-expanded', 'false');











      }











    });











  };























  document.addEventListener('click', event => {











    const toggle = event.target.closest('[data-action-menu] .action-menu__toggle');











    if (toggle) {











      const menu = toggle.closest('[data-action-menu]');











      const isOpen = menu?.classList.contains('is-open');











      closeAllMenus();











      if (menu && !isOpen) {











        menu.classList.add('is-open');











        toggle.setAttribute('aria-expanded', 'true');











      }











      event.preventDefault();











      event.stopPropagation();











      return;











    }























    const clickedInMenuItem = event.target.closest('[data-action-menu] .action-menu__list button, [data-action-menu] .action-menu__list a');











    if (clickedInMenuItem) {











      closeAllMenus();











      return;











    }























    const clickedInsideAnyMenu = event.target.closest('[data-action-menu]');











    if (!clickedInsideAnyMenu) {











      closeAllMenus();











    }











  });























  document.addEventListener('keydown', event => {











    if (event.key === 'Escape') {











      closeAllMenus();











    }











  });











});



































// Handle modal click - close if clicked outside dialog











window.handleModalClick = function(event, modalId) {











    // ??ï¿½??ï¿½??ï¿½ ??ï¿½???????? ??ï¿½??????ï¿½ dialog ??????ï¿½ ??ï¿½??ï¿½??ï¿½????? dialog ??ï¿½???????????ï¿½ ??ï¿½??ï¿½????????? ???????ï¿½??ï¿½??????ï¿½ ??ï¿½??ï¿½??ï¿½????? ??ï¿½??????ï¿½











    const dialog = event.currentTarget.querySelector('.modal-shell__dialog');











    if (dialog && (event.target === dialog || dialog.contains(event.target))) {











        return;











    }











    











    // ??ï¿½??ï¿½??ï¿½ ??ï¿½???????? backdrop ??????ï¿½ ??ï¿½??ï¿½??ï¿½??ï¿½ ??ï¿½??ï¿½ dialog ??ï¿½???????????ï¿½ ??ï¿½??ï¿½????????? modal ??ï¿½??ï¿½ ??ï¿½??ï¿½???????ï¿½











    if (modalId === 'postFormBox') {











        window.cancelPostForm();











    } else if (modalId === 'pollOptionsBox') {











        window.cancelPollForm();











    } else if (modalId === 'manageMembersModal') {











        if (typeof window.closeManageMembersModal === 'function') {











            window.closeManageMembersModal();











        }











    } else if (modalId === 'manageReportsModal') {











        if (typeof window.closeManageReportsModal === 'function') {











            window.closeManageReportsModal();











        }











    } else if (modalId === 'groupSettingsModal') {











        if (typeof window.closeGroupSettingsModal === 'function') {











            window.closeGroupSettingsModal();











        }











    }











};























