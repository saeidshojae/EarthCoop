  }
  
    // Ã˜Â§Ã›Å’Ã™â€  ÃšÂ©Ã˜Â¯ Ã˜Â­Ã˜Â°Ã™Â Ã˜Â´Ã˜Â¯ Ãšâ€ Ã™Ë†Ã™â€  Ã˜Â¨Ã˜Â§ Ã™â€¦Ã™â€ Ã˜Â·Ã™â€š Ã˜Â­Ã™ÂÃ˜Â¸ Ã™â€¦Ã™Ë†Ã™â€šÃ˜Â¹Ã›Å’Ã˜Âª scroll Ã˜Â¯Ã˜Â± chat.blade.php Ã˜ÂªÃ˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â¯
    // window.addEventListener('DOMContentLoaded', function () {
