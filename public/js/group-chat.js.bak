        }
    };
    
    // Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â¹ Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â¯Ã˜Â±Ã›Å’Ã˜Â§Ã™ÂÃ˜Âª Ã˜Â¢Ã˜Â®Ã˜Â±Ã›Å’Ã™â€  message ID Ã˜Â§Ã˜Â² Ã˜ÂµÃ™ÂÃ˜Â­Ã™â€¡
    function getLastMessageId() {
        if (renderedMessageIds && renderedMessageIds.size) {
            return Math.max(...renderedMessageIds);
        }

        const chatBox = document.getElementById('chat-box');
        if (!chatBox) {            return null;
        }

        const messages = chatBox.querySelectorAll('[data-message-id]');
        if (messages.length === 0) {            return null;
        }

        let maxId = 0;
        messages.forEach(msg => {
            const msgId = parseInt(msg.getAttribute('data-message-id'));
            if (msgId && !isNaN(msgId) && msgId > maxId) {
                maxId = msgId;
                if (renderedMessageIds) {
                    renderedMessageIds.add(msgId);
                }
            }
        });

        return maxId > 0 ? maxId : null;
    }
    
    // Ã˜ÂªÃ˜Â¹Ã˜Â±Ã›Å’Ã™Â startPolling Ã˜Â¯Ã˜Â± scope global Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â¯Ã˜Â³Ã˜ÂªÃ˜Â±Ã˜Â³Ã›Å’ Ã˜Â§Ã˜Â² DOMContentLoaded
    window.startPolling = function startPolling() {
        const runtimeConfig = getChatRuntimeConfig();
        if (!runtimeConfig.enabled) {
            return;
        }

        if (pollingStarted) {
            return;
        }
        
        // Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ groupId - Ã™ÂÃ™â€šÃ˜Â· Ã˜Â§Ã˜Â² window.groupId Ã˜Â§Ã˜Â³Ã˜ÂªÃ™ÂÃ˜Â§Ã˜Â¯Ã™â€¡ Ã™â€¦Ã›Å’Ã¢â‚¬Å’ÃšÂ©Ã™â€ Ã›Å’Ã™â€¦
        if (typeof window.groupId === 'undefined' || !window.groupId) {
            console.error('Ã¢ÂÅ’ window.groupId not found! Cannot start polling. window.groupId:', window.groupId);
            return;
        }
        
        const currentGroupId = window.groupId;
        // Ã˜Â¯Ã˜Â±Ã›Å’Ã˜Â§Ã™ÂÃ˜Âª Ã˜Â¢Ã˜Â®Ã˜Â±Ã›Å’Ã™â€  message ID Ã˜Â§Ã˜Â² Ã˜ÂµÃ™ÂÃ˜Â­Ã™â€¡ Ã™ÂÃ˜Â¹Ã™â€žÃ›Å’
        lastMessageId = getLastMessageId();
        renderedMessageIds = new Set(Array.from(document.querySelectorAll('[data-message-id]')).map(el => parseInt(el.getAttribute('data-message-id'))).filter(id => !isNaN(id)));
        // Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ ÃšÂ©Ã™â€  ÃšÂ©Ã™â€¡ Ã˜Â¢Ã›Å’Ã˜Â§ scroll restore Ã˜Â´Ã˜Â¯Ã™â€¡ Ã˜Â§Ã˜Â³Ã˜Âª
        // Ã˜Â§ÃšÂ¯Ã˜Â± Ã˜Â¨Ã˜Â¹Ã˜Â¯ Ã˜Â§Ã˜Â² 5 Ã˜Â«Ã˜Â§Ã™â€ Ã›Å’Ã™â€¡ Ã™â€¡Ã™â€ Ã™Ë†Ã˜Â² restore Ã™â€ Ã˜Â´Ã˜Â¯Ã™â€¡Ã˜Å’ polling Ã˜Â±Ã˜Â§ Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹ ÃšÂ©Ã™â€ 
        let attempts = 0;
        const maxAttempts = 10;
        const checkInterval = setInterval(function() {
            attempts++;
            if (window.scrollPositionRestored || attempts >= maxAttempts) {
                clearInterval(checkInterval);
                pollingStarted = true;
                // Ã˜Â­Ã˜Â§Ã™â€žÃ˜Â§ polling Ã˜Â±Ã˜Â§ Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹ ÃšÂ©Ã™â€  - Ã™â€¡Ã˜Â± 1.5 Ã˜Â«Ã˜Â§Ã™â€ Ã›Å’Ã™â€¡ Ã›Å’ÃšÂ©Ã˜Â¨Ã˜Â§Ã˜Â±
                const pollingIntervalMs = resolvePollingIntervalMs();
                pollingInterval = setInterval(function() {
                    // Ã˜Â¯Ã˜Â±Ã›Å’Ã˜Â§Ã™ÂÃ˜Âª groupId Ã˜Â§Ã˜Â² window
                    if (typeof window.groupId === 'undefined' || !window.groupId) {
                        console.error('Ã¢ÂÅ’ window.groupId not found during polling!');
                        return;
                    }
                    
                    const currentGroupId = window.groupId;
                    syncPostFeed(currentGroupId);
                    if (!window.__lastReconcileAt || Date.now() - window.__lastReconcileAt > 30000) {
                        window.__lastReconcileAt = Date.now();
                        reconcileRenderedPosts(currentGroupId);
                    }
                    
                    // Ã˜Â¯Ã˜Â±Ã›Å’Ã˜Â§Ã™ÂÃ˜Âª Ã˜Â¢Ã˜Â®Ã˜Â±Ã›Å’Ã™â€  message ID Ã™â€šÃ˜Â¨Ã™â€ž Ã˜Â§Ã˜Â² Ã˜Â¯Ã˜Â±Ã˜Â®Ã™Ë†Ã˜Â§Ã˜Â³Ã˜Âª
                    const currentLastId = getLastMessageId();
                    const requestLastId = lastMessageId || currentLastId;
                    // Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ jQuery
                    if (typeof $ === 'undefined' || typeof $.ajax === 'undefined') {
                        console.error('Ã¢ÂÅ’ jQuery not loaded! Cannot make AJAX request.');
                        return;
                    }
                    
                    $.ajax({
                        url: '/api/groups/' + currentGroupId + '/messages',
                        method: 'GET',
                        data: {
                            last_message_id: requestLastId
                        },
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json'
                        },
                        dataType: 'text',
                        success: function(response) {
                            let payload = response;
                            if (typeof payload === 'string') {
                                const sanitized = payload.replace(/^\uFEFF/, '').trim();
                                try {
                                    payload = sanitized ? JSON.parse(sanitized) : {};
                                } catch (parseError) {
                                    console.error('Polling JSON parse error:', parseError);
                                    console.error('Raw polling response:', response);
                                    return;
                                }
                            }

                            // FORCE LOG - Ã™â€¡Ã™â€¦Ã›Å’Ã˜Â´Ã™â€¡ Ã™â€ Ã™â€¦Ã˜Â§Ã›Å’Ã˜Â´ Ã˜Â¨Ã˜Â¯Ã™â€¡
                            // Store the current scroll position
                            const chatBox = document.getElementById('chat-box');
                            if (!chatBox) {
                                console.error('Ã¢ÂÅ’ chat-box element not found!');
                                return;
                            }
                            
                            // Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ Ã˜Â¯Ã™â€šÃ›Å’Ã™â€šÃ¢â‚¬Å’Ã˜ÂªÃ˜Â± "Ã˜Â¯Ã˜Â± Ã™Â¾Ã˜Â§Ã›Å’Ã›Å’Ã™â€  Ã˜Â¨Ã™Ë†Ã˜Â¯Ã™â€ " - Ã™ÂÃ™â€šÃ˜Â· Ã˜Â§ÃšÂ¯Ã˜Â± ÃšÂ©Ã˜Â§Ã˜Â±Ã˜Â¨Ã˜Â± Ã™Ë†Ã˜Â§Ã™â€šÃ˜Â¹Ã˜Â§Ã™â€¹ Ã˜Â®Ã™Ë†Ã˜Â¯Ã˜Â´ Ã˜Â¨Ã™â€¡ Ã™Â¾Ã˜Â§Ã›Å’Ã›Å’Ã™â€  Ã˜Â±Ã™ÂÃ˜ÂªÃ™â€¡ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯
                            const scrollBottom = chatBox.scrollHeight - chatBox.scrollTop;
                            const threshold = 50;
                            const isScrolledToBottom = scrollBottom <= chatBox.clientHeight + threshold;
                            
                            // Store the current edit form state if it exists
                            const activeEditForm = document.querySelector('.edit-form[style*="display: block"]');
                            const activeEditFormId = activeEditForm ? activeEditForm.id : null;
                            const activeEditContent = activeEditForm ? document.getElementById(`edit-message-${activeEditFormId.split('-')[2]}`).value : null;
                            
                            // Parse JSON response
                            let newMessages = [];
                            if (payload && payload.messages && Array.isArray(payload.messages)) {
                                // Ã™ÂÃ™â€šÃ˜Â· Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã˜Â¬Ã˜Â¯Ã›Å’Ã˜Â¯ Ã˜Â±Ã˜Â§ Ã™ÂÃ›Å’Ã™â€žÃ˜ÂªÃ˜Â± ÃšÂ©Ã™â€ 
                                const existingMessageIds = new Set();
                                document.querySelectorAll('[data-message-id]').forEach(msg => {
                                    const msgId = parseInt(msg.getAttribute('data-message-id'));
                                    if (msgId) {
                                        existingMessageIds.add(msgId);
                                    }
                                });
                                
                                newMessages = payload.messages.filter(msg => {
                                    return msg && msg.type === 'message' && msg.id && !existingMessageIds.has(msg.id);
                                });
                            } else {
                            }
                            
                            // Append only new messages
                            const hadNewMessages = newMessages.length > 0;
                            if (hadNewMessages) {
                            }
                            
                            newMessages.forEach(function(messageData, index) {
                                if (messageData && messageData.id && renderedMessageIds) {
                                    renderedMessageIds.add(messageData.id);
                                }
                                // Ã˜Â§Ã˜Â³Ã˜ÂªÃ™ÂÃ˜Â§Ã˜Â¯Ã™â€¡ Ã˜Â§Ã˜Â² Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â¹ appendMessage ÃšÂ©Ã™â€¡ Ã™â€šÃ˜Â¨Ã™â€žÃ˜Â§Ã™â€¹ Ã˜ÂªÃ˜Â¹Ã˜Â±Ã›Å’Ã™Â Ã˜Â´Ã˜Â¯Ã™â€¡
                                if (typeof appendMessage === 'function') {
                                    try {
                                        appendMessage(messageData);
                                        // Ã˜Â¨Ã™â€¡Ã¢â‚¬Å’Ã˜Â±Ã™Ë†Ã˜Â²Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ Ã›Å’ lastMessageId
                                        if (messageData.id && (!lastMessageId || messageData.id > lastMessageId)) {
                                            lastMessageId = messageData.id;
                                        }
                                    } catch (error) {
                                        console.error('Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’ CRITICAL ERROR adding message:', error);
                                        console.error('Error stack:', error.stack);
                                        console.error('Message data:', messageData);
                                        // Ã™â€ Ã™â€¦Ã˜Â§Ã›Å’Ã˜Â´ alert Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ debugging
                                        alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã™ÂÃ˜Â²Ã™Ë†Ã˜Â¯Ã™â€  Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦: ' + error.message);
                                    }
                                } else {
                                    console.error('Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’ appendMessage function NOT FOUND!');
                                    console.error('Available functions:', Object.keys(window).filter(k => k.includes('append')));
                                    alert('Ã˜Â®Ã˜Â·Ã˜Â§: Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â¹ appendMessage Ã™Â¾Ã›Å’Ã˜Â¯Ã˜Â§ Ã™â€ Ã˜Â´Ã˜Â¯!');
                                }
                            });
                            
                            // Ã˜Â¨Ã™â€¡Ã¢â‚¬Å’Ã˜Â±Ã™Ë†Ã˜Â²Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ Ã›Å’ lastMessageId Ã˜Â§Ã˜Â² response
                            if (payload.latest_message_id && (!lastMessageId || payload.latest_message_id > lastMessageId)) {
                                lastMessageId = payload.latest_message_id;
                            }
                            
                            reapplySkillListState();
                            startPollCountdowns();

                            // Restore the edit form state if it existed
                            if (activeEditFormId && activeEditContent) {
                                const editForm = document.getElementById(activeEditFormId);
                                const editInput = document.getElementById(`edit-message-${activeEditFormId.split('-')[2]}`);
                                if (editForm && editInput) {
                                    editForm.style.display = 'block';
                                    editInput.value = activeEditContent;
                                    editInput.focus();
                                }
                            }

                            // Scroll to bottom ONLY if:
                            // 1. Scroll restore ÃšÂ©Ã˜Â§Ã™â€¦Ã™â€ž Ã˜Â´Ã˜Â¯Ã™â€¡ Ã˜Â§Ã˜Â³Ã˜Âª
                            // 2. ÃšÂ©Ã˜Â§Ã˜Â±Ã˜Â¨Ã˜Â± Ã™Ë†Ã˜Â§Ã™â€šÃ˜Â¹Ã˜Â§Ã™â€¹ Ã˜Â®Ã™Ë†Ã˜Â¯Ã˜Â´ Ã˜Â¨Ã™â€¡ Ã™Â¾Ã˜Â§Ã›Å’Ã›Å’Ã™â€  Ã˜Â±Ã™ÂÃ˜ÂªÃ™â€¡ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯ (Ã™â€ Ã™â€¡ Ã˜Â¯Ã˜Â± Ã™â€žÃ™Ë†Ã˜Â¯ Ã˜Â§Ã™Ë†Ã™â€žÃ›Å’Ã™â€¡)
                            // 3. Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜Â¬Ã˜Â¯Ã›Å’Ã˜Â¯ Ã˜Â§Ã˜Â¶Ã˜Â§Ã™ÂÃ™â€¡ Ã˜Â´Ã˜Â¯Ã™â€¡ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯
                            if (window.scrollPositionRestored && isScrolledToBottom && hadNewMessages) {
                                chatBox.scrollTop = chatBox.scrollHeight;
                            }
                        },
                        error: function(xhr, status, error) {
                            // Network churn (offline / network changed / tab hidden) should not flood console
                            if (xhr && xhr.status === 0) {
                                if (window.__chatPageUnloading || document.visibilityState === 'hidden' || !navigator.onLine) {
                                    return;
                                }
                                if (String(error || '').toLowerCase().includes('network')) {
                                    return;
                                }
                            }
                            console.error('Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’ POLLING ERROR Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’');
                            console.error('Status:', xhr.status);
                            console.error('Status Text:', xhr.statusText);
                            console.error('Error:', error);
                            console.error('Response Text:', xhr.responseText);
                            console.error('Response Headers:', xhr.getAllResponseHeaders());
                            
                            // Ã˜Â§ÃšÂ¯Ã˜Â± response text Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â¯Ã˜Å’ Ã˜Â³Ã˜Â¹Ã›Å’ ÃšÂ©Ã™â€  parse ÃšÂ©Ã™â€ 
                            if (xhr.responseText) {
                                try {
                                    const parsed = JSON.parse(xhr.responseText);
                                    console.error('Parsed error response:', parsed);
                                } catch (e) {
                                    console.error('Could not parse error response as JSON');
                                }
                            }
                            
                            // Ã˜Â¯Ã˜Â± Ã˜ÂµÃ™Ë†Ã˜Â±Ã˜Âª Ã˜Â®Ã˜Â·Ã˜Â§Ã˜Å’ polling Ã˜Â±Ã˜Â§ Ã˜Â§Ã˜Â¯Ã˜Â§Ã™â€¦Ã™â€¡ Ã˜Â¨Ã˜Â¯Ã™â€¡ (Ã™â€¦Ã™â€¦ÃšÂ©Ã™â€  Ã˜Â§Ã˜Â³Ã˜Âª Ã™â€¦Ã˜Â´ÃšÂ©Ã™â€ž Ã™â€¦Ã™Ë†Ã™â€šÃ˜ÂªÃ›Å’ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯)
                        }
                    });
                }, pollingIntervalMs);
            }
        }, 500); // Ã™â€¡Ã˜Â± 500ms Ãšâ€ ÃšÂ© ÃšÂ©Ã™â€ 
    }
    
document.addEventListener('DOMContentLoaded', function() {
    const chatBox = document.getElementById('chat-box');
    const form = document.getElementById('chatForm');
    const voiceFileInput = document.getElementById('voice-file-input');
    const voiceFilePreview = document.getElementById('voice-file-preview');
    const voiceFileName = document.getElementById('voice-file-name');
    const voiceFileSize = document.getElementById('voice-file-size');
    const voiceFileRemove = document.getElementById('voice-file-remove');

    // Format file size helper
    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Ã˜Â¨Ã˜Â§Ã›Å’Ã˜Âª';
        const k = 1024;
        const sizes = ['Ã˜Â¨Ã˜Â§Ã›Å’Ã˜Âª', 'ÃšÂ©Ã›Å’Ã™â€žÃ™Ë†Ã˜Â¨Ã˜Â§Ã›Å’Ã˜Âª', 'Ã™â€¦ÃšÂ¯Ã˜Â§Ã˜Â¨Ã˜Â§Ã›Å’Ã˜Âª', 'ÃšÂ¯Ã›Å’ÃšÂ¯Ã˜Â§Ã˜Â¨Ã˜Â§Ã›Å’Ã˜Âª'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
    }

    const updateVoiceFilePreview = (file) => {
        if (!voiceFilePreview) return;

        if (file) {
            if (voiceFileName) {
                voiceFileName.textContent = file.name;
            }
            if (voiceFileSize) {
                voiceFileSize.textContent = formatFileSize(file.size);
            }
            voiceFilePreview.style.display = 'flex';
            voiceFilePreview.style.setProperty('display', 'flex', 'important');
        } else {
            voiceFilePreview.style.display = 'none';
            voiceFilePreview.style.setProperty('display', 'none', 'important');
            if (voiceFileName) voiceFileName.textContent = '';
            if (voiceFileSize) voiceFileSize.textContent = '';
        }
    };

    voiceFileInput?.addEventListener('change', () => {
        updateVoiceFilePreview(voiceFileInput.files?.[0] || null);
    });

    voiceFileRemove?.addEventListener('click', (event) => {
        event.preventDefault();
        if (voiceFileInput) {
            voiceFileInput.value = '';
        }
        updateVoiceFilePreview(null);
    });

    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Sync CKEditor Ã™â€šÃ˜Â¨Ã™â€ž Ã˜Â§Ã˜Â² Ã˜Â®Ã™Ë†Ã˜Â§Ã™â€ Ã˜Â¯Ã™â€  Ã™â€¦Ã˜Â­Ã˜ÂªÃ™Ë†Ã˜Â§
            if (window.CKEDITOR && CKEDITOR.instances) {
                for (var i in CKEDITOR.instances) {
                    CKEDITOR.instances[i].updateElement();
                }
            }
            
            const formData = new FormData(form);
            const parentId = document.getElementById('parent_id').value;
            
            if (parentId) {
                formData.append('parent_id', parentId);
            }

            // Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ Ã™â€¦Ã˜Â­Ã˜ÂªÃ™Ë†Ã˜Â§Ã›Å’ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã™â€šÃ˜Â¨Ã™â€ž Ã˜Â§Ã˜Â² Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž
            const hasVoiceFile = voiceFileInput && voiceFileInput.files && voiceFileInput.files.length > 0;
            const messageEditor = window.CKEDITOR?.instances?.['message_editor'] || null;
            let messageText = '';
            let messageHtml = '';
            
            if (messageEditor) {
                messageHtml = messageEditor.getData().trim();
                // Ã˜ÂªÃ˜Â¨Ã˜Â¯Ã›Å’Ã™â€ž HTML Ã˜Â¨Ã™â€¡ plain text Ã˜Â¨Ã˜Â§ Ã˜Â­Ã™ÂÃ˜Â¸ line breaks
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = messageHtml;
                // Ã˜ÂªÃ˜Â¨Ã˜Â¯Ã›Å’Ã™â€ž <br> Ã™Ë† <p> Ã˜Â¨Ã™â€¡ line breaks
                const brs = tempDiv.querySelectorAll('br');
                brs.forEach(br => br.replaceWith('\n'));
                const ps = tempDiv.querySelectorAll('p, div');
                ps.forEach(p => {
                    if (p.nextSibling) {
                        p.appendChild(document.createTextNode('\n'));
                    }
                });
                messageText = tempDiv.textContent || tempDiv.innerText || '';
                messageText = messageText.trim();
            } else {
                const messageTextarea = document.getElementById('message_editor');
                if (messageTextarea) {
                    messageText = messageTextarea.value.trim();
                }
            }
            
            // Ã˜ÂªÃ™â€ Ã˜Â¸Ã›Å’Ã™â€¦ Ã™â€¦Ã˜Â­Ã˜ÂªÃ™Ë†Ã˜Â§ Ã˜Â¯Ã˜Â± formData (Ã˜Â§ÃšÂ¯Ã˜Â± CKEditor Ã˜Â§Ã˜Â³Ã˜ÂªÃ™ÂÃ˜Â§Ã˜Â¯Ã™â€¡ Ã™â€¦Ã›Å’Ã¢â‚¬Å’Ã˜Â´Ã™Ë†Ã˜Â¯Ã˜Å’ plain text Ã˜Â±Ã˜Â§ Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž ÃšÂ©Ã™â€ )
            if (messageEditor && messageText) {
                formData.set('message', messageText);
            }

            // Ã˜Â§ÃšÂ¯Ã˜Â± Ã™â€¡Ã™â€¦ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜Â®Ã˜Â§Ã™â€žÃ›Å’ Ã˜Â§Ã˜Â³Ã˜Âª Ã™Ë† Ã™â€¡Ã™â€¦ Ã™ÂÃ˜Â§Ã›Å’Ã™â€ž Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’ Ã™â€ Ã›Å’Ã˜Â³Ã˜ÂªÃ˜Å’ Ã˜Â§Ã˜Â² Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã˜Â¬Ã™â€žÃ™Ë†ÃšÂ¯Ã›Å’Ã˜Â±Ã›Å’ ÃšÂ©Ã™â€ 
            if (!messageText && !hasVoiceFile) {
                alert('Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã™â€ Ã™â€¦Ã›Å’Ã¢â‚¬Å’Ã˜ÂªÃ™Ë†Ã˜Â§Ã™â€ Ã˜Â¯ Ã˜Â®Ã˜Â§Ã™â€žÃ›Å’ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯.');
                e.stopPropagation();
                e.stopImmediatePropagation();
                return false;
            }
            
            // Ã˜Â°Ã˜Â®Ã›Å’Ã˜Â±Ã™â€¡ Ã™â€¦Ã™Ë†Ã™â€šÃ˜Â¹Ã›Å’Ã˜Âª Ã™â€šÃ˜Â¨Ã™â€ž Ã˜Â§Ã˜Â² submit (Ã˜Â§ÃšÂ¯Ã˜Â± Ã˜ÂªÃ˜Â§Ã˜Â¨Ã˜Â¹ Ã™â€¦Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯)
            if (typeof saveScrollPositionBeforeSubmit === 'function') {
                saveScrollPositionBeforeSubmit();
            }

            // Ã˜Â§ÃšÂ¯Ã˜Â± Ã™ÂÃ˜Â§Ã›Å’Ã™â€ž Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’ Ã˜Â§Ã™â€ Ã˜ÂªÃ˜Â®Ã˜Â§Ã˜Â¨ Ã˜Â´Ã˜Â¯Ã™â€¡ Ã™Ë† message Ã˜Â®Ã˜Â§Ã™â€žÃ›Å’ Ã˜Â§Ã˜Â³Ã˜ÂªÃ˜Å’ Ã›Å’ÃšÂ© Ã™â€¦Ã™â€šÃ˜Â¯Ã˜Â§Ã˜Â± Ã™Â¾Ã›Å’Ã˜Â´Ã¢â‚¬Å’Ã™ÂÃ˜Â±Ã˜Â¶ Ã˜Â§Ã˜Â¶Ã˜Â§Ã™ÂÃ™â€¡ ÃšÂ©Ã™â€ 
            if (hasVoiceFile && !messageText) {
                if (messageEditor) {
                    messageEditor.setData('Ã°Å¸Å½Â¤ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’');
                } else {
                    const messageTextarea = document.getElementById('message_editor');
                    if (messageTextarea) {
                        messageTextarea.value = 'Ã°Å¸Å½Â¤ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’';
                    }
                }
                formData.set('message', 'Ã°Å¸Å½Â¤ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’');
            }
            
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': getCsrfToken(),
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const responseData = await safeReadJson(response);

                if (!response.ok) {
                    if (response.status === 422) {
                        const errorMessage = responseData.message || 'Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜Â¹Ã˜ÂªÃ˜Â¨Ã˜Â§Ã˜Â±Ã˜Â³Ã™â€ Ã˜Â¬Ã›Å’ Ã˜Â¯Ã˜Â§Ã˜Â¯Ã™â€¡Ã¢â‚¬Å’Ã™â€¡Ã˜Â§';
                        const errors = responseData.errors ? Object.values(responseData.errors).flat().join('\n') : '';
                        alert(`${errorMessage}\n${errors}`);
                        return; // Ã˜Â¬Ã™â€žÃ™Ë†ÃšÂ¯Ã›Å’Ã˜Â±Ã›Å’ Ã˜Â§Ã˜Â² Ã˜Â§Ã˜Â¯Ã˜Â§Ã™â€¦Ã™â€¡ Ã˜Â§Ã˜Â¬Ã˜Â±Ã˜Â§
                    } else if (response.status === 500) {
                        console.error('Server Error Details:', responseData);
                        alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â³Ã˜Â±Ã™Ë†Ã˜Â±. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â¯Ã™Ë†Ã˜Â¨Ã˜Â§Ã˜Â±Ã™â€¡ Ã˜ÂªÃ™â€žÃ˜Â§Ã˜Â´ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯. Ã˜Â§ÃšÂ¯Ã˜Â± Ã™â€¦Ã˜Â´ÃšÂ©Ã™â€ž Ã˜Â§Ã˜Â¯Ã˜Â§Ã™â€¦Ã™â€¡ Ã˜Â¯Ã˜Â§Ã˜Â´Ã˜ÂªÃ˜Å’ Ã˜Â¨Ã˜Â§ Ã™Â¾Ã˜Â´Ã˜ÂªÃ›Å’Ã˜Â¨Ã˜Â§Ã™â€ Ã›Å’ Ã˜ÂªÃ™â€¦Ã˜Â§Ã˜Â³ Ã˜Â¨ÃšÂ¯Ã›Å’Ã˜Â±Ã›Å’Ã˜Â¯.');
                        return; // Ã˜Â¬Ã™â€žÃ™Ë†ÃšÂ¯Ã›Å’Ã˜Â±Ã›Å’ Ã˜Â§Ã˜Â² Ã˜Â§Ã˜Â¯Ã˜Â§Ã™â€¦Ã™â€¡ Ã˜Â§Ã˜Â¬Ã˜Â±Ã˜Â§
                    } else {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                }
                
                if (responseData.status === 'success') {
                    appendMessage(responseData.message);
                    // Ã˜Â¨Ã™â€¡Ã¢â‚¬Å’Ã˜Â±Ã™Ë†Ã˜Â²Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ Ã›Å’ lastMessageId Ã˜Â¨Ã˜Â¹Ã˜Â¯ Ã˜Â§Ã˜Â² Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦
                    if (responseData.message && responseData.message.id) {
                        if (!lastMessageId || responseData.message.id > lastMessageId) {
                            lastMessageId = responseData.message.id;
                        }
                    }
                    form.reset();
                    
                    // Clear voice file input and preview
                    if (voiceFileInput) {
                        voiceFileInput.value = '';
                    }
                    updateVoiceFilePreview(null);
                    
                    // Clear CKEditor if exists
                    const messageEditor = window.CKEDITOR?.instances?.['message_editor'] || null;
                    if (messageEditor) {
                        messageEditor.setData('');
                    }
                    
                    // Clear parent_id after successful submission
                    document.getElementById('parent_id').value = '';
                    // Hide reply indicator
                    const replyIndicator = document.querySelector('.reply-indicator');
                    if (replyIndicator) {
                        replyIndicator.remove();
                    }
                } else {
                    alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦: ' + (responseData.message || 'Ã˜Â®Ã˜Â·Ã˜Â§Ã›Å’ Ã™â€ Ã˜Â§Ã˜Â´Ã™â€ Ã˜Â§Ã˜Â®Ã˜ÂªÃ™â€¡'));
                }
            } catch (error) {
                console.error('Error:', error);
                if (error.message.includes('Failed to fetch')) {
                    alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜ÂªÃ˜ÂµÃ˜Â§Ã™â€ž Ã˜Â¨Ã™â€¡ Ã˜Â³Ã˜Â±Ã™Ë†Ã˜Â±. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â§Ã˜ÂªÃ˜ÂµÃ˜Â§Ã™â€ž Ã˜Â§Ã›Å’Ã™â€ Ã˜ÂªÃ˜Â±Ã™â€ Ã˜Âª Ã˜Â®Ã™Ë†Ã˜Â¯ Ã˜Â±Ã˜Â§ Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯.');
                } else {
                    alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â¯Ã™Ë†Ã˜Â¨Ã˜Â§Ã˜Â±Ã™â€¡ Ã˜ÂªÃ™â€žÃ˜Â§Ã˜Â´ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯.');
                }
            }
        });
    }
    
    initRealtimeMessages();

    // ========== POLLING MECHANISM ==========
    // Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹ polling Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â¯Ã˜Â±Ã›Å’Ã˜Â§Ã™ÂÃ˜Âª Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã˜Â¬Ã˜Â¯Ã›Å’Ã˜Â¯
    // Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ window.groupId
    if (typeof window.groupId === 'undefined') {
        console.error('Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’ window.groupId is NOT DEFINED! Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’');
        console.error('Available window properties:', Object.keys(window).filter(k => k.toLowerCase().includes('group')));
        console.error('All window properties starting with "group":', Object.keys(window).filter(k => k.toLowerCase().includes('group')));
    } else {
        // Ã˜Â´Ã˜Â±Ã™Ë†Ã˜Â¹ polling Ã˜Â¨Ã˜Â¹Ã˜Â¯ Ã˜Â§Ã˜Â² 2 Ã˜Â«Ã˜Â§Ã™â€ Ã›Å’Ã™â€¡ Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â§Ã˜Â·Ã™â€¦Ã›Å’Ã™â€ Ã˜Â§Ã™â€  Ã˜Â§Ã˜Â² Ã™â€žÃ™Ë†Ã˜Â¯ ÃšÂ©Ã˜Â§Ã™â€¦Ã™â€ž
        setTimeout(function() {
            if (typeof window.startPolling === 'function') {
                window.startPolling();
            } else {
                console.error('Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’ window.startPolling function NOT FOUND! Ã¢ÂÅ’Ã¢ÂÅ’Ã¢ÂÅ’');
                console.error('Available functions:', Object.keys(window).filter(k => typeof window[k] === 'function' && k.toLowerCase().includes('poll')));
            }
        }, 2000);
    }
    // ========== END POLLING MECHANISM ==========
});

function appendMessage(message) {
    const chatBox = document.getElementById('chat-box');
    if (!chatBox) return;
    if (!message || !message.id) return;
    if (isMessageRendered(message.id)) return;
    if (renderedMessageIds) {
        renderedMessageIds.add(message.id);
    }

    const isMine = message.user_id == authUserId;
    const senderName = message.sender || 'ÃšÂ©Ã˜Â§Ã˜Â±Ã˜Â¨Ã˜Â±';
    const initials = senderName.split(' ').map(n => n.charAt(0)).join(' ').trim() || 'Ã˜Å¸';
    // Ã™â€¦Ã˜Â­Ã˜ÂªÃ™Ë†Ã˜Â§ Ã˜Â§Ã˜Â² backend Ã˜Â¨Ã˜Â§ <br> Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ line breaks Ã™â€¦Ã›Å’Ã¢â‚¬Å’Ã˜Â¢Ã›Å’Ã˜Â¯Ã˜Å’ Ã™â€¦Ã˜Â³Ã˜ÂªÃ™â€šÃ›Å’Ã™â€¦Ã˜Â§Ã™â€¹ Ã˜Â§Ã˜Â³Ã˜ÂªÃ™ÂÃ˜Â§Ã˜Â¯Ã™â€¡ Ã™â€¦Ã›Å’Ã¢â‚¬Å’ÃšÂ©Ã™â€ Ã›Å’Ã™â€¦
    const messageContent = message.message || '';
    const formattedTime = message.created_at || new Date().toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' });
    const currentUserRole = typeof window.yourRole !== 'undefined' ? Number(window.yourRole) : 0;
    const canPin = currentUserRole === 3 || isMine;
    
    // Escape HTML helper
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    // Strip HTML helper
    function stripHtml(html) {
        const tmp = document.createElement('DIV');
        tmp.innerHTML = html;
        return tmp.textContent || tmp.innerText || '';
    }

    // Format user content safely (escape + preserve line breaks)
    function formatMessageContent(text) {
        const escaped = escapeHtml(text || '');
        return escaped.replace(/\n/g, '<br>');
    }

    const safeMessageHtml = formatMessageContent(messageContent);
    
    // Generate reactions HTML
    function generateReactionsHTML(messageId, reactions) {
        if (!reactions || reactions.length === 0) return '';
        const emojis = { like: 'Ã°Å¸â€˜Â', love: 'Ã¢ÂÂ¤Ã¯Â¸Â', laugh: 'Ã°Å¸Ëœâ€š', wow: 'Ã°Å¸ËœÂ®', sad: 'Ã°Å¸ËœÂ¢', angry: 'Ã°Å¸ËœÂ ' };
        return `<div class="message-reactions" style="display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap;">${reactions.map(r => {
            const type = r.type || r.reaction_type || '';
            const count = r.count || 0;
            return `<span class="reaction-badge" style="background: #f0f0f0; padding: 2px 6px; border-radius: 12px; font-size: 12px; cursor: pointer;" onclick="if(typeof toggleReaction === 'function') toggleReaction(${messageId}, '${type}')">${emojis[type] || 'Ã°Å¸â€˜Â'} ${count}</span>`;
        }).join('')}</div>`;
    }
    
    const messageRow = document.createElement('div');
    messageRow.className = `message-row ${isMine ? 'you' : 'other'}`;
    messageRow.setAttribute('data-message-id', message.id);
    messageRow.id = `msg-${message.id}`;
    
    let messageHTML = '';
    
    // Ã˜Â¢Ã™Ë†Ã˜Â§Ã˜ÂªÃ˜Â§Ã˜Â± (Ã™ÂÃ™â€šÃ˜Â· Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã˜Â¯Ã›Å’ÃšÂ¯Ã˜Â±Ã˜Â§Ã™â€ )
    if (!isMine) {
        messageHTML += `<a href="/profile/member/${message.user_id}" class="avatar-link"><span class="avatar"><span>${initials}</span></span></a>`;
    }
    
    // Reply preview
    let replyPreviewHTML = '';
    if (message.parent_id && message.parent_sender && message.parent_content) {
        replyPreviewHTML = `<div class="reply-preview"><div class="reply-sender">${escapeHtml(message.parent_sender)}</div><div class="reply-text">${escapeHtml(message.parent_content.substring(0, 80))}</div></div>`;
    }
    
    // Voice message
    let voiceMessageHTML = '';
    if (message.voice_message) {
        // Convert relative path to full URL if needed
        let voiceUrl = message.voice_message;
        if (!voiceUrl.startsWith('http://') && !voiceUrl.startsWith('https://')) {
            // Remove leading slash if exists
            voiceUrl = voiceUrl.startsWith('/') ? voiceUrl.substring(1) : voiceUrl;
            // Build full URL - encode each part separately to handle spaces
            const pathParts = voiceUrl.split('/');
            const encodedParts = pathParts.map(part => encodeURIComponent(part));
            voiceUrl = window.location.origin + '/storage/' + encodedParts.join('/');
        }
        const voiceType = message.file_type || 'audio/webm';
        voiceMessageHTML = `<div class="voice-message-container" style="margin-top: 12px; padding: 12px; background: ${isMine ? '#e3f2fd' : '#f5f5f5'}; border-radius: 12px; border: 1px solid ${isMine ? '#90caf9' : '#e0e0e0'}; direction: ltr;"><div style="display: flex; align-items: center; gap: 12px;"><div style="width: 40px; height: 40px; border-radius: 50%; background: ${isMine ? '#2196f3' : '#757575'}; display: flex; align-items: center; justify-content: center; color: white;"><i class="fas fa-microphone"></i></div><div style="flex: 1;"><div style="font-size: 12px; color: #666; margin-bottom: 4px;"><i class="fas fa-headphones"></i> Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’</div><audio controls style="width: 100%; height: 40px;" preload="metadata"><source src="${voiceUrl}" type="${voiceType}"><source src="${voiceUrl}" type="audio/webm"><source src="${voiceUrl}" type="audio/ogg"><source src="${voiceUrl}" type="audio/mpeg">Ã™â€¦Ã˜Â±Ã™Ë†Ã˜Â±ÃšÂ¯Ã˜Â± Ã˜Â´Ã™â€¦Ã˜Â§ Ã˜Â§Ã˜Â² Ã™Â¾Ã˜Â®Ã˜Â´ Ã˜ÂµÃ˜Â¯Ã˜Â§ Ã™Â¾Ã˜Â´Ã˜ÂªÃ›Å’Ã˜Â¨Ã˜Â§Ã™â€ Ã›Å’ Ã™â€ Ã™â€¦Ã›Å’Ã¢â‚¬Å’ÃšÂ©Ã™â€ Ã˜Â¯.</audio></div></div></div>`;
    }
    
    messageHTML += `
        <div class="message-bubble ${isMine ? 'you' : 'other'}" data-message-id="${message.id}" data-user-id="${message.user_id}" data-edit-url="/messages/${message.id}/edit" data-delete-url="/messages/${message.id}/delete" data-report-url="/messages/${message.id}/report" data-content-raw="${escapeHtml(stripHtml(messageContent))}">
            <div class="message-head">
                ${isMine ? 
                    // Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã˜Â®Ã™Ë†Ã˜Â¯ ÃšÂ©Ã˜Â§Ã˜Â±Ã˜Â¨Ã˜Â±: Ã˜Â³Ã™â€¡ Ã™â€ Ã™â€šÃ˜Â·Ã™â€¡ Ã˜Â¯Ã˜Â± Ã˜Â³Ã™â€¦Ã˜Âª Ãšâ€ Ã™Â¾Ã˜Å’ Ã™â€ Ã˜Â§Ã™â€¦ Ã˜Â¯Ã˜Â± Ã˜Â³Ã™â€¦Ã˜Âª Ã˜Â±Ã˜Â§Ã˜Â³Ã˜Âª
                    `<div class="action-menu message-action" data-action-menu>
                        <button type="button" class="action-menu__toggle"><i class="fas fa-ellipsis-v"></i></button>
                        <div class="action-menu__list">
                            <button type="button" onclick="replyToMessage('${message.id}', '${escapeHtml(senderName)}', '${escapeHtml(messageContent.substring(0, 50))}')" class="action-menu__item btn-rep"><i class="fas fa-reply"></i> Ã™Â¾Ã˜Â§Ã˜Â³Ã˜Â®</button>
                            <button type="button" class="action-menu__item btn-reaction"><i class="fas fa-smile"></i> Ã™Ë†Ã˜Â§ÃšÂ©Ã™â€ Ã˜Â´</button>
                            ${canPin ? `<button type="button" class="action-menu__item btn-pin" onclick="pinMessage('${message.id}')"><i class="fas fa-thumbtack"></i> Ã˜Â³Ã™â€ Ã˜Â¬Ã˜Â§Ã™â€š ÃšÂ©Ã˜Â±Ã˜Â¯Ã™â€ </button>` : ''}
                            <button type="button" class="action-menu__item btn-edit"><i class="fas fa-edit"></i> Ã™Ë†Ã›Å’Ã˜Â±Ã˜Â§Ã›Å’Ã˜Â´</button>
                            <button type="button" class="action-menu__item action-menu__item--danger btn-delete"><i class="fas fa-trash"></i> Ã˜Â­Ã˜Â°Ã™Â</button>
                            <div class="menu-meta-time"><div class="menu-meta-time__item"><i class="fas fa-paper-plane" style="font-size: 0.7rem; opacity: 0.6; margin-left: 4px;"></i><span class="menu-meta-time__label">Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã˜Â´Ã˜Â¯Ã™â€¡:</span><span class="menu-meta-time__value">${formattedTime}</span></div></div>
                        </div>
                    </div>
                    <div class="message-head__info">
                        <span class="message-sender message-sender--self">Ã˜Â´Ã™â€¦Ã˜Â§</span>
                    </div>` :
                    // Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã˜Â¯Ã›Å’ÃšÂ¯Ã˜Â±Ã˜Â§Ã™â€ : Ã™â€ Ã˜Â§Ã™â€¦ ÃšÂ©Ã˜Â§Ã˜Â±Ã˜Â¨Ã˜Â± Ã˜Â¯Ã˜Â± Ã˜Â³Ã™â€¦Ã˜Âª Ãšâ€ Ã™Â¾Ã˜Å’ Ã˜Â³Ã™â€¡ Ã™â€ Ã™â€šÃ˜Â·Ã™â€¡ Ã˜Â¯Ã˜Â± Ã˜Â³Ã™â€¦Ã˜Âª Ã˜Â±Ã˜Â§Ã˜Â³Ã˜Âª
                    `<div class="message-head__info">
                        <a href="/profile-member/${message.user_id}" class="message-sender" onclick="event.stopPropagation(); window.location.href='/profile-member/${message.user_id}'; return false;">${escapeHtml(senderName)}</a>
                    </div>
                    <div class="action-menu message-action" data-action-menu>
                        <button type="button" class="action-menu__toggle"><i class="fas fa-ellipsis-v"></i></button>
                        <div class="action-menu__list">
                            <button type="button" onclick="replyToMessage('${message.id}', '${escapeHtml(senderName)}', '${escapeHtml(messageContent.substring(0, 50))}')" class="action-menu__item btn-rep"><i class="fas fa-reply"></i> Ã™Â¾Ã˜Â§Ã˜Â³Ã˜Â®</button>
                            <button type="button" class="action-menu__item btn-reaction"><i class="fas fa-smile"></i> Ã™Ë†Ã˜Â§ÃšÂ©Ã™â€ Ã˜Â´</button>
                            ${canPin ? `<button type="button" class="action-menu__item btn-pin" onclick="pinMessage('${message.id}')"><i class="fas fa-thumbtack"></i> Ã˜Â³Ã™â€ Ã˜Â¬Ã˜Â§Ã™â€š ÃšÂ©Ã˜Â±Ã˜Â¯Ã™â€ </button>` : ''}
                            <button type="button" class="action-menu__item btn-report"><i class="fas fa-flag"></i> ÃšÂ¯Ã˜Â²Ã˜Â§Ã˜Â±Ã˜Â´</button>
                            <div class="menu-meta-time"><div class="menu-meta-time__item"><i class="fas fa-paper-plane" style="font-size: 0.7rem; opacity: 0.6; margin-left: 4px;"></i><span class="menu-meta-time__label">Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã˜Â´Ã˜Â¯Ã™â€¡:</span><span class="menu-meta-time__value">${formattedTime}</span></div></div>
                        </div>
                    </div>`
                }
            </div>
            ${replyPreviewHTML}
            <p class="message-content">${safeMessageHtml}</p>
            ${voiceMessageHTML}
            <div class="message-timestamp" style="display: flex !important; align-items: center; gap: 6px; margin-top: 4px; flex-wrap: wrap; margin-left: -10px !important; margin-right: -10px !important; padding-left: 10px !important; padding-right: 10px !important; justify-content: space-between !important; float: none !important; text-align: left !important; direction: ltr !important;">
                ${isMine ? '<div class="read-receipt" style="font-size: 10px; text-align: left; direction: ltr; margin-right: auto; margin-left: 0;"><span style="color: #9ca3af;"><i class="fas fa-check"></i> Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã˜Â´Ã˜Â¯Ã™â€¡</span></div>' : ''}
                <div style="display: flex; align-items: center; gap: 4px; flex: 1; justify-content: center;">
                    ${(message.reactions && message.reactions.length > 0) ? generateReactionsHTML(message.id, message.reactions) : ''}
                </div>
                <div style="display: flex; align-items: center; gap: 4px; margin-left: auto;">
                    <span class="message-time">${formattedTime}</span>
                </div>
            </div>
        </div>
    `;
    
    messageRow.innerHTML = messageHTML;
    chatBox.appendChild(messageRow);
    
    // Initialize reaction button for this message
    if (typeof addReactionButton === 'function') {
        const messageBubble = messageRow.querySelector('.message-bubble');
        if (messageBubble) {
            addReactionButton(message.id);
        }
    }
    
    // Initialize click handler for profile link
    const profileLink = messageRow.querySelector('a.message-sender');
    if (profileLink) {
        profileLink.addEventListener('click', function(e) {
            // Ã˜Â§Ã˜Â¬Ã˜Â§Ã˜Â²Ã™â€¡ Ã˜Â¨Ã˜Â¯Ã™â€¡ Ã™â€žÃ›Å’Ã™â€ ÃšÂ© ÃšÂ©Ã˜Â§Ã˜Â± ÃšÂ©Ã™â€ Ã˜Â¯
            e.stopPropagation();
            e.preventDefault();
            // Ã˜Â§ÃšÂ¯Ã˜Â± href Ã™Ë†Ã˜Â¬Ã™Ë†Ã˜Â¯ Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â¯Ã˜Å’ Ã˜Â¨Ã™â€¡ Ã˜Â¢Ã™â€  Ã˜Â¨Ã˜Â±Ã™Ë†
            const href = this.getAttribute('href');
            if (href && !href.includes('#')) {
                window.location.href = href;
            }
        });
    }
    
    // Initialize action menu handlers if function exists
    if (typeof initializeMessageActions === 'function') {
        initializeMessageActions(messageRow);
    }
    
    // Initialize action menu toggle
    const menu = messageRow.querySelector('[data-action-menu]');
    if (menu) {
        const toggle = menu.querySelector('.action-menu__toggle');
        const list = menu.querySelector('.action-menu__list');
        
        if (toggle && list) {
            toggle.addEventListener('click', function(event) {
                event.preventDefault();
                event.stopPropagation();
                const isOpen = menu.classList.contains('is-open');
                // Close all other menus
                document.querySelectorAll('[data-action-menu].is-open').forEach(m => {
                    if (m !== menu) m.classList.remove('is-open');
                });
                menu.classList.toggle('is-open', !isOpen);
            });
            
            // Ã˜Â¨Ã˜Â³Ã˜ÂªÃ™â€  Ã™â€¦Ã™â€ Ã™Ë† Ã™â€¡Ã™â€ ÃšÂ¯Ã˜Â§Ã™â€¦ ÃšÂ©Ã™â€žÃ›Å’ÃšÂ© Ã˜Â±Ã™Ë†Ã›Å’ Ã˜Â¯ÃšÂ©Ã™â€¦Ã™â€¡Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã™â€¦Ã™â€ Ã™Ë† (Ã˜Â¨Ã™â€¡ Ã˜Â¬Ã˜Â² Ã˜Â¯ÃšÂ©Ã™â€¦Ã™â€¡ Ã™Ë†Ã˜Â§ÃšÂ©Ã™â€ Ã˜Â´)
            list.querySelectorAll('button, a').forEach(item => {
                // Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â¯ÃšÂ©Ã™â€¦Ã™â€¡ Ã™Ë†Ã˜Â§ÃšÂ©Ã™â€ Ã˜Â´Ã˜Å’ event listener Ã˜Â¬Ã˜Â¯Ã˜Â§ÃšÂ¯Ã˜Â§Ã™â€ Ã™â€¡ Ã˜Â§Ã˜Â¶Ã˜Â§Ã™ÂÃ™â€¡ Ã™â€ Ã™â€¦Ã›Å’Ã¢â‚¬Å’ÃšÂ©Ã™â€ Ã›Å’Ã™â€¦
                // Ãšâ€ Ã™Ë†Ã™â€  addReactionButton Ã˜Â®Ã™Ë†Ã˜Â¯Ã˜Â´ event handler Ã˜Â§Ã˜Â¶Ã˜Â§Ã™ÂÃ™â€¡ Ã™â€¦Ã›Å’Ã¢â‚¬Å’ÃšÂ©Ã™â€ Ã˜Â¯
                if (item.classList.contains('btn-reaction')) {
                    return;
                }
                
                item.addEventListener('click', function(e) {
                    menu.classList.remove('is-open');
                    toggle?.setAttribute('aria-expanded', 'false');
                });
            });
        }
    }
    
    // Scroll to the bottom of the chat - Ã™ÂÃ™â€šÃ˜Â· Ã˜Â§ÃšÂ¯Ã˜Â± scroll restore ÃšÂ©Ã˜Â§Ã™â€¦Ã™â€ž Ã˜Â´Ã˜Â¯Ã™â€¡ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯
    // Ã™Ë† ÃšÂ©Ã˜Â§Ã˜Â±Ã˜Â¨Ã˜Â± Ã˜Â®Ã™Ë†Ã˜Â¯Ã˜Â´ Ã˜Â¨Ã™â€¡ Ã™Â¾Ã˜Â§Ã›Å’Ã›Å’Ã™â€  Ã˜Â±Ã™ÂÃ˜ÂªÃ™â€¡ Ã˜Â¨Ã˜Â§Ã˜Â´Ã˜Â¯
    // Ã˜Â¯Ã˜Â± Ã˜ÂºÃ›Å’Ã˜Â± Ã˜Â§Ã›Å’Ã™â€  Ã˜ÂµÃ™Ë†Ã˜Â±Ã˜ÂªÃ˜Å’ scroll restore Ã˜Â®Ã™Ë†Ã˜Â¯Ã˜Â´ Ã™â€¦Ã™Ë†Ã™â€šÃ˜Â¹Ã›Å’Ã˜Âª Ã˜Â±Ã˜Â§ Ã˜ÂªÃ™â€ Ã˜Â¸Ã›Å’Ã™â€¦ Ã™â€¦Ã›Å’Ã¢â‚¬Å’ÃšÂ©Ã™â€ Ã˜Â¯
    // Ã˜Â§Ã›Å’Ã™â€  ÃšÂ©Ã˜Â¯ Ã˜Â­Ã˜Â°Ã™Â Ã˜Â´Ã˜Â¯ Ãšâ€ Ã™Ë†Ã™â€  Ã˜Â¨Ã˜Â§ scroll restore Ã˜ÂªÃ˜Â¯Ã˜Â§Ã˜Â®Ã™â€ž Ã˜Â¯Ã˜Â§Ã˜Â±Ã˜Â¯
}

function closeAllModals() {
  closeElectionBox(); 
  cancelPostForm();
  cancelPollForm()
  closeSkill()
  cancelelectionForm()
}

function startPollCountdowns() {
  document.querySelectorAll('.poll-timer').forEach(timer => {
    if (timer.dataset.timerSet === "true") return;

    const expiresAtStr = timer.getAttribute('data-expires');
    if (!expiresAtStr) {
      timer.innerText = 'Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  Ã˜Â²Ã™â€¦Ã˜Â§Ã™â€  Ã™Â¾Ã˜Â§Ã›Å’Ã˜Â§Ã™â€ ';
      return;
    }

    const expiresAt = new Date(expiresAtStr);

    function updateTimer() {
      const now = new Date();
      const diffMs = expiresAt - now;

      if (isNaN(diffMs)) {
        timer.innerText = 'Ã˜ÂªÃ˜Â§Ã˜Â±Ã›Å’Ã˜Â® Ã™â€ Ã˜Â§Ã™â€¦Ã˜Â¹Ã˜ÂªÃ˜Â¨Ã˜Â±';
        return;
      }

      if (diffMs <= 0) {
        timer.innerText = 'Ã™Â¾Ã˜Â§Ã›Å’Ã˜Â§Ã™â€  Ã›Å’Ã˜Â§Ã™ÂÃ˜ÂªÃ™â€¡';
        return;
      }

      const totalSeconds = Math.floor(diffMs / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
if (hours > 24) {
    const days = Math.floor(hours / 24);
    const remainingHours = hours % 24;

    timer.innerText = `${days} Ã˜Â±Ã™Ë†Ã˜Â² ${remainingHours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
} else {
    timer.innerText = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
}

    }

    updateTimer();
    setInterval(updateTimer, 1000);

    timer.dataset.timerSet = "true";
  });
}

// Voice recording functionality
let mediaRecorder;
let audioChunks = [];
let isRecording = false;

// Wait for DOM to be fully loaded
document.addEventListener('DOMContentLoaded', function() {
    const voiceRecordBtn = document.getElementById('voice-record-btn');
    const stopRecordingBtn = document.getElementById('stop-recording');

    if (voiceRecordBtn) {
        voiceRecordBtn.addEventListener('click', startRecording);
    }

    if (stopRecordingBtn) {
        stopRecordingBtn.addEventListener('click', stopRecording);
    }
});

async function startRecording() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];
        
        
        mediaRecorder.ondataavailable = (event) => {
            audioChunks.push(event.data);
        };
        
        mediaRecorder.onstop = async () => {
            const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
            const reader = new FileReader();
            reader.readAsDataURL(audioBlob);
            reader.onloadend = async () => {
                const voiceMessageInput = document.getElementById('voice_message');
                if (voiceMessageInput) {
                    voiceMessageInput.value = reader.result;
                    
                    const form = document.getElementById('chatForm');
                    if (form) {
                        const formData = new FormData(form);
                        // Add an empty message field to satisfy server validation
                        formData.append('message', '[Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’]');
                        
                        try {
                            const response = await fetch(form.action, {
                                method: 'POST',
                                headers: {
                                    'X-CSRF-TOKEN': getCsrfToken(),
                                    'Accept': 'application/json'
                                },
                                body: formData
                            });

                            const responseData = await safeReadJson(response);

                            if (!response.ok) {
                                if (response.status === 422) {
                                    const errorMessage = responseData.message || 'Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜Â¹Ã˜ÂªÃ˜Â¨Ã˜Â§Ã˜Â±Ã˜Â³Ã™â€ Ã˜Â¬Ã›Å’ Ã˜Â¯Ã˜Â§Ã˜Â¯Ã™â€¡Ã¢â‚¬Å’Ã™â€¡Ã˜Â§';
                                    const errors = responseData.errors ? Object.values(responseData.errors).flat().join('\n') : '';
                                    alert(`${errorMessage}\n${errors}`);
                                } else if (response.status === 500) {
                                    console.error('Server Error Details:', responseData);
                                    alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â³Ã˜Â±Ã™Ë†Ã˜Â±. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â¯Ã™Ë†Ã˜Â¨Ã˜Â§Ã˜Â±Ã™â€¡ Ã˜ÂªÃ™â€žÃ˜Â§Ã˜Â´ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯. Ã˜Â§ÃšÂ¯Ã˜Â± Ã™â€¦Ã˜Â´ÃšÂ©Ã™â€ž Ã˜Â§Ã˜Â¯Ã˜Â§Ã™â€¦Ã™â€¡ Ã˜Â¯Ã˜Â§Ã˜Â´Ã˜ÂªÃ˜Å’ Ã˜Â¨Ã˜Â§ Ã™Â¾Ã˜Â´Ã˜ÂªÃ›Å’Ã˜Â¨Ã˜Â§Ã™â€ Ã›Å’ Ã˜ÂªÃ™â€¦Ã˜Â§Ã˜Â³ Ã˜Â¨ÃšÂ¯Ã›Å’Ã˜Â±Ã›Å’Ã˜Â¯.');
                                } else {
                                    throw new Error(`HTTP error! status: ${response.status}`);
                                }
                            }
                            
                            if (responseData.status === 'success') {
                                appendMessage(responseData.message);
                                form.reset();
                            } else {
                                alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’: ' + (responseData.message || 'Ã˜Â®Ã˜Â·Ã˜Â§Ã›Å’ Ã™â€ Ã˜Â§Ã˜Â´Ã™â€ Ã˜Â§Ã˜Â®Ã˜ÂªÃ™â€¡'));
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            if (error.message.includes('Failed to fetch')) {
                                alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜ÂªÃ˜ÂµÃ˜Â§Ã™â€ž Ã˜Â¨Ã™â€¡ Ã˜Â³Ã˜Â±Ã™Ë†Ã˜Â±. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â§Ã˜ÂªÃ˜ÂµÃ˜Â§Ã™â€ž Ã˜Â§Ã›Å’Ã™â€ Ã˜ÂªÃ˜Â±Ã™â€ Ã˜Âª Ã˜Â®Ã™Ë†Ã˜Â¯ Ã˜Â±Ã˜Â§ Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯.');
                            } else {
                                alert('Ã˜Â®Ã˜Â·Ã˜Â§ Ã˜Â¯Ã˜Â± Ã˜Â§Ã˜Â±Ã˜Â³Ã˜Â§Ã™â€ž Ã™Â¾Ã›Å’Ã˜Â§Ã™â€¦ Ã˜ÂµÃ™Ë†Ã˜ÂªÃ›Å’. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â¯Ã™Ë†Ã˜Â¨Ã˜Â§Ã˜Â±Ã™â€¡ Ã˜ÂªÃ™â€žÃ˜Â§Ã˜Â´ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯.');
                            }
                        }
                    }
                }
            };
        };
        
        mediaRecorder.start();
        isRecording = true;
        
        const voiceRecording = document.getElementById('voice-recording');
        const voiceRecordBtn = document.getElementById('voice-record-btn');
        
        if (voiceRecording) {
            voiceRecording.style.display = 'flex';
        }
        if (voiceRecordBtn) {
            voiceRecordBtn.style.display = 'none';
        }
        
    } catch (err) {
        console.error('Error accessing microphone:', err);
        alert('Ã˜Â¯Ã˜Â³Ã˜ÂªÃ˜Â±Ã˜Â³Ã›Å’ Ã˜Â¨Ã™â€¡ Ã™â€¦Ã›Å’ÃšÂ©Ã˜Â±Ã™Ë†Ã™ÂÃ™Ë†Ã™â€  Ã˜Â§Ã™â€¦ÃšÂ©Ã˜Â§Ã™â€ Ã¢â‚¬Å’Ã™Â¾Ã˜Â°Ã›Å’Ã˜Â± Ã™â€ Ã›Å’Ã˜Â³Ã˜Âª. Ã™â€žÃ˜Â·Ã™ÂÃ˜Â§Ã™â€¹ Ã˜Â¯Ã˜Â³Ã˜ÂªÃ˜Â±Ã˜Â³Ã›Å’ Ã˜Â±Ã˜Â§ Ã˜Â¨Ã˜Â±Ã˜Â±Ã˜Â³Ã›Å’ ÃšÂ©Ã™â€ Ã›Å’Ã˜Â¯.');
    }
}

function stopRecording() {
    if (isRecording && mediaRecorder) {
        mediaRecorder.stop();
        isRecording = false;
        
        // Stop all tracks
        mediaRecorder.stream.getTracks().forEach(track => track.stop());
        
        // Hide recording UI
        const voiceRecording = document.getElementById('voice-recording');
        const voiceRecordBtn = document.getElementById('voice-record-btn');
        
        if (voiceRecording) {
            voiceRecording.style.display = 'none';
        }
        if (voiceRecordBtn) {
            voiceRecordBtn.style.display = 'block';
        }
    }
}

// Add click handler for reply (using event delegation for dynamic messages)
document.addEventListener('DOMContentLoaded', function() {
    const chatBoxEl = document.getElementById('chat-box');
    if (chatBoxEl) {
        // Event listener Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã™â€žÃ›Å’Ã™â€ ÃšÂ©Ã¢â‚¬Å’Ã™â€¡Ã˜Â§Ã›Å’ Ã™Â¾Ã˜Â±Ã™Ë†Ã™ÂÃ˜Â§Ã›Å’Ã™â€ž - Ã˜Â¨Ã˜Â§Ã›Å’Ã˜Â¯ Ã˜Â§Ã™Ë†Ã™â€ž Ã˜Â§Ã˜Â¬Ã˜Â±Ã˜Â§ Ã˜Â´Ã™Ë†Ã˜Â¯
        chatBoxEl.addEventListener('click', function(e) {
            const link = e.target.closest('a.message-sender');
            if (link && link.href) {
                // Ã˜Â§Ã˜Â¬Ã˜Â§Ã˜Â²Ã™â€¡ Ã˜Â¨Ã˜Â¯Ã™â€¡ Ã™â€žÃ›Å’Ã™â€ ÃšÂ© ÃšÂ©Ã˜Â§Ã˜Â± ÃšÂ©Ã™â€ Ã˜Â¯ - Ã™â€¡Ã›Å’Ãšâ€  ÃšÂ©Ã˜Â§Ã˜Â±Ã›Å’ Ã™â€ ÃšÂ©Ã™â€ 
                return;
            }
        }, true); // Ã˜Â§Ã˜Â³Ã˜ÂªÃ™ÂÃ˜Â§Ã˜Â¯Ã™â€¡ Ã˜Â§Ã˜Â² capture phase Ã˜Â¨Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â§Ã˜Â¬Ã˜Â±Ã˜Â§Ã›Å’ Ã˜Â²Ã™Ë†Ã˜Â¯Ã˜ÂªÃ˜Â±
        
        chatBoxEl.addEventListener('click', function(e) {
            // Ã˜Â§ÃšÂ¯Ã˜Â± Ã˜Â±Ã™Ë†Ã›Å’ Ã™â€žÃ›Å’Ã™â€ ÃšÂ© ÃšÂ©Ã™â€žÃ›Å’ÃšÂ© Ã˜Â´Ã˜Â¯Ã™â€¡Ã˜Å’ Ã˜Â§Ã˜Â¬Ã˜Â§Ã˜Â²Ã™â€¡ Ã˜Â¨Ã˜Â¯Ã™â€¡ Ã˜Â¨Ã™â€¡ Ã™Â¾Ã˜Â±Ã™Ë†Ã™ÂÃ˜Â§Ã›Å’Ã™â€ž Ã˜Â¨Ã˜Â±Ã™Ë†Ã˜Â¯
            if (e.target.closest('a.message-sender') || e.target.closest('.message-head__info a')) {
                return; // Ã˜Â§Ã˜Â¬Ã˜Â§Ã˜Â²Ã™â€¡ Ã˜Â¨Ã˜Â¯Ã™â€¡ Ã™â€žÃ›Å’Ã™â€ ÃšÂ© ÃšÂ©Ã˜Â§Ã˜Â± ÃšÂ©Ã™â€ Ã˜Â¯
            }
            
            const bubble = e.target.closest('.message-bubble');
            if (!bubble) return;
            
            if (e.target.closest('.reply-box')) return;
            
            // Try to find message ID from different possible parent elements
            const messageRow = bubble.closest('.message-row');
            const messageWrapper = bubble.closest('.message-wrapper');
            const messageId = messageRow?.dataset?.messageId || 
                             messageWrapper?.dataset?.messageId || 
                             bubble.dataset?.messageId;
            
            if (messageId) {
                const parentIdInput = document.getElementById('parent_id');
                if (parentIdInput) {
                    parentIdInput.value = messageId;
                }
            }
        });
    }
});

function replyToMessage(messageId, senderName, content) {
    // Find the reply indicator container
    const replyContainer = document.getElementById('reply-indicator-container');
    if (!replyContainer) {
        console.error('Reply indicator container not found');
        return;
    }

    // Create reply indicator content directly in container (Ã˜Â¨Ã˜Â¯Ã™Ë†Ã™â€  wrapper Ã˜Â§Ã˜Â¶Ã˜Â§Ã™ÂÃ›Å’)
    replyContainer.innerHTML = `
        <div class="reply-info">
            <div class="reply-arrow"></div>
            <div style="flex: 1; min-width: 0;">
                <div class="reply-sender-name">${senderName}</div>
                <div class="reply-content">${content}</div>
            </div>
        </div>
        <button class="btn-cancel-reply" onclick="cancelReply()">
            <i class="fas fa-times"></i>
        </button>
    `;
    replyContainer.style.display = 'block';

    // Set parent_id in form
    const parentIdInput = document.getElementById('parent_id');
    if (parentIdInput) {
        parentIdInput.value = messageId;
    }

    // Scroll to input
    const chatForm = document.getElementById('chatForm');
    if (chatForm) {
        chatForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}

function cancelReply() {
    // Hide reply indicator container
    const replyContainer = document.getElementById('reply-indicator-container');
    if (replyContainer) {
        replyContainer.innerHTML = '';
        replyContainer.style.display = 'none';
    }
    
    // Remove reply indicator (fallback for old code)
    const replyIndicator = document.querySelector('.reply-indicator');
    if (replyIndicator && replyIndicator.parentElement === document.body) {
        replyIndicator.remove();
    }

    // Clear parent_id
    const parentIdInput = document.getElementById('parent_id');
    if (parentIdInput) {
        parentIdInput.value = '';
    }
}

// Add event listener for form submit to clear reply after sending
const chatForm = document.getElementById('chatForm');
if (chatForm) {
    chatForm.addEventListener('submit', function() {
        setTimeout(cancelReply, 100);
    });
}

