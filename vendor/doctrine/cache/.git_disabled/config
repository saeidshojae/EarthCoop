[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/doctrine/cache.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	pushurl = git@github.com:doctrine/cache.git
[branch "2.2.x"]
	remote = origin
	merge = refs/heads/2.2.x
[remote "composer"]
	url = https://github.com/doctrine/cache.git
	fetch = +refs/heads/*:refs/remotes/composer/*
