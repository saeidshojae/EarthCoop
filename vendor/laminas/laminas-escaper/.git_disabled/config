[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/laminas/laminas-escaper.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	pushurl = git@github.com:laminas/laminas-escaper.git
[branch "2.19.x"]
	remote = origin
	merge = refs/heads/2.19.x
[remote "composer"]
	url = https://github.com/laminas/laminas-escaper.git
	fetch = +refs/heads/*:refs/remotes/composer/*
